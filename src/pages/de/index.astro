---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecodeText from '../../components/DecodeText.astro';
import Terminal from '../../components/Terminal.astro';
---
<BaseLayout
  lang="de"
  title="Softwarearchitekt / Consultant / Maker"
  description="Verteilte Systeme mit Akka.net, Event-basiert, hochverfügbar und flexibel."
  altHref="/en/"
  showIntro
>
  <div class="shell hero">
    <p class="mono-label kicker">// Softwarearchitekt / Consultant / Maker</p>
    <h1><DecodeText text="Systeme, nachhaltig denken." delay={210} /></h1>
    <p class="sub">Verteilte Systeme mit Akka.net, Event-basiert, hochverfügbar und flexibel.</p>
  </div>
  <Terminal lang="de" />
</BaseLayout>
<style>
  .hero {
    padding-block: 3rem 1.5rem;
  }
  .kicker {
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-size: clamp(2.5rem, 12vw, 5.5rem);
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 44ch;
    margin-top: 1.25rem;
  }
</style>
