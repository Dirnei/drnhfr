---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CvDocument from '../../../components/CvDocument.astro';
import { routePath } from '../../../i18n/routes';
---
<BaseLayout
  lang="de"
  current="cv"
  title="Lebenslauf — Christian Dirnhofer"
  description="Stationen, Fähigkeiten und Ausbildung von Christian Dirnhofer."
  altHref={routePath('cv', 'en')}
  noindex
>
  <div class="shell cv-locked" id="cv-locked">
    <p class="line">$ cat lebenslauf</p>
    <p class="line err">cat: lebenslauf: Zugriff verweigert</p>
    <p class="line">
      Der Lebenslauf ist nur über die Shell auf der <a href="/de/">Startseite</a>{' '}
      erreichbar — dort mit <code>su &lt;code&gt;</code> freischalten.
    </p>
  </div>
  <div class="shell cv" id="cv-content" hidden>
    <CvDocument lang="de" />
  </div>
</BaseLayout>
<style>
  .cv {
    max-width: 50rem;
  }
  .cv-locked {
    max-width: 50rem;
    padding-block: 3rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .cv-locked .line {
    margin: 0;
  }
  .cv-locked .err {
    color: var(--red-text);
  }
  .cv-locked a {
    color: var(--boot-info);
  }
  .cv-locked a:hover {
    color: var(--red-text);
  }
</style>
<script is:inline>
  try {
    if (sessionStorage.getItem('cv-unlocked') === '1') {
      document.getElementById('cv-locked').hidden = true;
      document.getElementById('cv-content').hidden = false;
    }
  } catch {
    // Not fatal: worst case the cv stays locked for this visit.
  }
</script>
