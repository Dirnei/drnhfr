---
import { Image } from 'astro:assets';
import portrait from '../../../assets/christian-dirnhofer.jpg';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { routePath } from '../../../i18n/routes';
---
<BaseLayout
  lang="en"
  current="contact"
  title="Contact — Christian Dirnhofer"
  description="How to reach Christian Dirnhofer."
  altHref={routePath('contact', 'de')}
>
  <div class="shell contact">
    <h1>Contact</h1>
    <Image
      src={portrait}
      alt="Christian Dirnhofer"
      width={180}
      height={180}
      class="portrait"
      loading="eager"
    />
    <p>Email is quickest. I usually reply very fast.</p>
    <ul class="links">
      <li>
        <span class="mono-label">Email</span>
        <a href="mailto:christian@dirnhofer.net">christian@dirnhofer.net</a>
      </li>
      <li>
        <span class="mono-label">LinkedIn</span>
        <a href="https://www.linkedin.com/in/christian-dirnhofer-a89b4a229/">
          christian-dirnhofer
        </a>
      </li>
      <li>
        <span class="mono-label">GitHub</span>
        <a href="https://github.com/Dirnei">Dirnei</a>
      </li>
    </ul>
  </div>
</BaseLayout>
<style>
  h1 {
    font-size: clamp(2rem, 8vw, 3.5rem);
    padding-block: 2rem 1rem;
  }
  .portrait {
    display: block;
    width: 180px;
    height: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--hairline);
  }
  .contact p {
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .links {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
  .links li {
    border-top: 1px solid var(--hairline-soft);
    padding-block: 0.75rem;
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
  }
  .links a:hover {
    color: var(--red);
  }
</style>
