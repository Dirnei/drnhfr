---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryRow from '../../../components/EntryRow.astro';
import { getPosts } from '../../../lib/entries';
import { slugOf } from '../../../lib/ids';
import { useTranslations } from '../../../i18n/ui';
import { routePath } from '../../../i18n/routes';

const t = useTranslations('en');
const posts = await getPosts('en');
---
<BaseLayout
  lang="en"
  current="blog"
  title="Blog — Christian Dirnhofer"
  description="Articles on distributed systems, .NET, and whatever I take apart in the evening."
  altHref={routePath('blog', 'de')}
>
  <div class="shell">
    <h1>{t('blog.title')}</h1>
    {posts.length === 0 && <p class="mono-label">{t('blog.empty')}</p>}
    <ul class="rows">
      {
        posts.map((post, index) => (
          <EntryRow
            href={`/en/blog/${slugOf(post.id)}/`}
            index={index}
            title={post.data.title}
            kind="Article"
          />
        ))
      }
    </ul>
  </div>
</BaseLayout>
<style>
  h1 {
    font-size: clamp(2rem, 8vw, 3.5rem);
    padding-block: 2rem 1.25rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
</style>
