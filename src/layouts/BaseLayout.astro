---
import '../styles/base.css';
import Logo from '../components/Logo.astro';
import SiteNav from '../components/SiteNav.astro';
import BootIntro from '../components/BootIntro.astro';
import TerminalShortcut from '../components/TerminalShortcut.astro';
import { routePath, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'de' | 'en';
  title: string;
  description: string;
  altHref: string;
  current?: RouteKey;
  altAvailable?: boolean;
  showIntro?: boolean;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  altHref,
  current,
  altAvailable = true,
  showIntro = false,
  noindex = false,
} = Astro.props;
const other = lang === 'de' ? 'en' : 'de';
const canonical = new URL(Astro.url.pathname, Astro.site);
const t = useTranslations(lang);
const shortcutKey = lang === 'de' ? 'Strg K' : 'Ctrl K';
const shortcutHint = lang === 'de' ? 'zum terminal' : 'for terminal';
const xDefaultHref =
  lang === 'de' ? canonical : altAvailable ? new URL(altHref, Astro.site) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/open-sans-latin-wdth-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {altAvailable && <link rel="alternate" hreflang={other} href={new URL(altHref, Astro.site)} />}
    <link rel="alternate" hreflang={lang} href={canonical} />
    {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Christian Dirnhofer — Blog (${lang})`}
      href={`/${lang}/rss.xml`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Christian Dirnhofer" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`/og-${lang}.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {showIntro && <BootIntro lang={lang} />}
    <a class="skip-link" href="#main">
      {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href={`/${lang}/`} aria-label="drnhfr"><Logo size={40} /></a>
        <nav class="nav">
          <SiteNav lang={lang} current={current} altHref={altHref} altAvailable={altAvailable} />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <ul class="footer-list">
          <li><a href={routePath('imprint', lang)}>{t('nav.imprint')}</a></li>
          <li><a href={routePath('privacy', lang)}>{t('nav.privacy')}</a></li>
        </ul>
        <p class="footer-hint"><kbd>/</kbd> <kbd>{shortcutKey}</kbd> {shortcutHint}</p>
      </div>
    </footer>
    <TerminalShortcut lang={lang} />
  </body>
</html>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ink);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.75rem;
  }
  .nav {
    margin-left: auto;
  }
  @media (max-width: 37.5rem) {
    .header-inner {
      flex-wrap: wrap;
    }
    .nav {
      margin-left: 0;
      flex-basis: 100%;
    }
    .footer-list {
      flex-wrap: wrap;
    }
  }
  .site-footer {
    border-top: 1px solid var(--hairline);
    margin-top: 4rem;
    padding-block: 1.25rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-list {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .footer-list a:hover {
    color: var(--red);
  }
  .footer-hint {
    margin: 0 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--text-dim);
  }
  .footer-hint kbd {
    font-family: inherit;
    border: 1px solid var(--hairline);
    padding: 0 0.25rem;
  }
  @media (max-width: 37.5rem) {
    .footer-hint {
      margin-left: 0;
    }
  }
</style>
