---
/*
 * The mark itself lives in src/assets/logo.svg — edit that file (Inkscape
 * opens it directly) and both this header logo and the generated Open Graph
 * cards follow. Nothing is hand-copied here any more.
 *
 * Astro inlines the imported SVG, so it stays a real <svg> in the document:
 * it inherits colour, scales crisply, and costs no extra request.
 */
import LogoMark from '../assets/logo.svg';

interface Props {
  size?: number;
}

const { size = 40 } = Astro.props;
---
<LogoMark width={size} height={size} role="img" aria-label="drnhfr" class="logo" />
<style>
  .logo {
    display: block;
  }
</style>
