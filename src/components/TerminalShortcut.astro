---
import type { Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const homeHref = `/${lang}/`;
---
<script define:vars={{ homeHref }}>
  const FOCUS_KEY = 'focus-terminal';

  document.addEventListener('keydown', (event) => {
    if (document.documentElement.dataset.intro === 'running') return;

    const bare = !event.metaKey && !event.ctrlKey && !event.altKey;
    const isSlash = event.key === '/' && bare;
    const isK = (event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey);
    if (!isSlash && !isK) return;

    const target = event.target;
    if (target instanceof Element && target.closest('input, textarea, select, [contenteditable]')) {
      return;
    }

    event.preventDefault();

    // Already home: the prompt is right here.
    const input = document.getElementById('terminal-input');
    if (input) {
      input.scrollIntoView({ block: 'center' });
      input.focus();
      return;
    }

    try {
      sessionStorage.setItem(FOCUS_KEY, '1');
    } catch {
      // Not fatal: the home page simply won't take focus on arrival.
    }
    window.location.href = homeHref;
  });
</script>
