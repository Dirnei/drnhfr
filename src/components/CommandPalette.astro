---
import type { Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const placeholder = lang === 'de' ? 'seite oder artikel suchen…' : 'search pages or articles…';
const emptyText = lang === 'de' ? 'nichts gefunden' : 'nothing found';
const dialogLabel = lang === 'de' ? 'Befehlspalette' : 'Command palette';
const resultsLabel = lang === 'de' ? 'Ergebnisse' : 'Results';
---
<dialog class="palette" id="palette" aria-label={dialogLabel}>
  <input
    type="text"
    id="palette-input"
    class="palette-input"
    placeholder={placeholder}
    aria-label={placeholder}
    role="combobox"
    aria-expanded="false"
    aria-controls="palette-results"
    aria-autocomplete="list"
    autocomplete="off"
    spellcheck="false"
  />
  <ul class="palette-results" id="palette-results" role="listbox" aria-label={resultsLabel}></ul>
  <p class="palette-empty" id="palette-empty" role="status" aria-live="polite" hidden>{emptyText}</p>
</dialog>

<style>
  .palette {
    width: min(34rem, calc(100vw - 2rem));
    margin-top: 12vh;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    color: var(--text);
  }
  .palette::backdrop {
    background: color-mix(in srgb, var(--ink) 88%, transparent);
  }
  .palette-input {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.85rem 1rem;
  }
  .palette-input:focus {
    outline: none;
    border-bottom-color: var(--red);
  }
  .palette-results {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 50vh;
    overflow-y: auto;
  }
  /*
   * The result <li>/<a> nodes are inserted at runtime via innerHTML (see
   * script below), so they never receive Astro's per-build
   * data-astro-cid-* scoping attribute. A scoped selector like
   * ".palette-results li a" compiles to requiring that attribute on every
   * element in the chain, which those dynamic nodes can never have — so
   * the rule would silently never match. ":global()" on the dynamic part
   * keeps ".palette-results" itself scoped (it's static markup) while
   * leaving the descendants unscoped so they still match.
   */
  .palette-results :global(li a) {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .palette-results :global(li a .kind) {
    margin-left: auto;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  /*
   * No separate :hover rule: hovering a row moves the same `cursor` that
   * the keyboard uses (see the "mouseover" listener below), which sets
   * aria-selected itself. That keeps exactly one row ever styled as
   * selected, whether the last input was a key or the mouse, instead of a
   * hover rule and a selected-state rule disagreeing about which row is
   * "active". :focus-visible stays as a defensive fallback since these
   * anchors are tabindex="-1" in normal use.
   */
  .palette-results :global(li a):focus-visible,
  .palette-results :global(li[aria-selected='true'] a) {
    background: color-mix(in srgb, var(--red) 14%, var(--surface));
    color: var(--red);
    outline: none;
  }
  .palette-empty {
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin: 0;
  }
</style>

<script define:vars={{ lang }}>
  const dialog = document.getElementById('palette');
  const input = document.getElementById('palette-input');
  const list = document.getElementById('palette-results');
  const empty = document.getElementById('palette-empty');

  let entries = [];
  // Caches the in-flight/completed fetch itself, not just a boolean, so
  // concurrent callers (see the `opening` guard below — belt and braces if
  // load() is ever reached from more than one path) all await the same
  // request instead of each firing their own.
  let fetchPromise = null;
  let cursor = 0;

  function load() {
    if (!fetchPromise) {
      fetchPromise = fetch(`/${lang}/search.json`)
        .then((response) => response.json())
        .then((data) => {
          entries = data;
          return data;
        })
        .catch((error) => {
          // Let a failed load be retried on the next open attempt instead
          // of permanently caching a rejection.
          fetchPromise = null;
          throw error;
        });
    }
    return fetchPromise;
  }

  // Single source of truth for which row is selected: every path that
  // changes the selection (initial render, arrow keys, mouse hover) goes
  // through this function, so `cursor`, the `aria-selected` attribute that
  // drives the red styling, and `aria-activedescendant` can never disagree
  // about which row is active.
  function select(index) {
    const items = list.querySelectorAll('li');
    if (items.length === 0) {
      cursor = 0;
      input.removeAttribute('aria-activedescendant');
      return;
    }
    cursor = ((index % items.length) + items.length) % items.length;
    items.forEach((item, i) => {
      item.setAttribute('aria-selected', i === cursor ? 'true' : 'false');
    });
    items[cursor].scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', items[cursor].id);
  }

  function render(query) {
    const needle = query.trim().toLowerCase();
    const matches = needle
      ? entries.filter((entry) => entry.title.toLowerCase().includes(needle))
      : entries;

    list.innerHTML = matches
      .slice(0, 8)
      .map(
        (entry, index) =>
          `<li role="option" id="palette-option-${index}" aria-selected="false">` +
          `<a href="${entry.href}" tabindex="-1">${entry.title}<span class="kind">${entry.kind}</span></a>` +
          `</li>`,
      )
      .join('');
    empty.hidden = matches.length > 0;
    input.setAttribute('aria-expanded', matches.length > 0 ? 'true' : 'false');
    select(0);
  }

  function move(step) {
    select(cursor + step);
  }

  function isIntroRunning() {
    return document.documentElement.dataset.intro === 'running';
  }

  // Set synchronously before the first `await` below, and only cleared on
  // the dialog's "close" event (or if load() throws before the dialog ever
  // opens). That closes the window a double-tap of "/" or Ctrl+K used to
  // land in: previously the guard was `!dialog.open`, but dialog.open only
  // becomes true *after* showModal(), which runs after `await load()`
  // resolves — so a second trigger fired while the first fetch was still
  // pending passed the guard, issued its own fetch, and then threw
  // InvalidStateError calling showModal() on an already-open dialog. With
  // `opening` set before any awaiting happens, a second trigger during that
  // window now sees it's already true and is a no-op.
  let opening = false;

  // showModal() traps focus and Escape/backdrop handling for free, but it
  // does not reliably stop the page behind it from scrolling on wheel
  // input in every browser. BootIntro locks scroll the same way for the
  // same reason, so this mirrors that pattern: lock on open, always
  // restore on close via the dialog's native "close" event (fired for
  // Escape, backdrop clicks and dialog.close() alike) so the two locks
  // can never fight — the intro guard above also means they never run at
  // the same time.
  async function open() {
    if (isIntroRunning() || opening) return;
    opening = true;
    try {
      await load();
      input.value = '';
      render('');
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      input.focus();
    } catch (error) {
      opening = false;
      console.error('command palette: failed to load search index', error);
    }
  }

  function close() {
    if (dialog.open) dialog.close();
  }

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const typingElsewhere =
      target instanceof HTMLElement &&
      (['INPUT', 'TEXTAREA'].includes(target.tagName) || target.isContentEditable);

    if (
      !opening &&
      !typingElsewhere &&
      !isIntroRunning() &&
      (event.key === '/' || (event.key === 'k' && (event.metaKey || event.ctrlKey)))
    ) {
      event.preventDefault();
      open();
      return;
    }

    if (!dialog.open) return;

    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const link = list.querySelectorAll('li')[cursor]?.querySelector('a');
      if (link) window.location.href = link.getAttribute('href');
    }
  });

  input.addEventListener('input', () => render(input.value));
  // Hovering a row moves the selection through the same `select()` used by
  // the keyboard, so the mouse and the keyboard can never disagree about
  // which row is active — there's no separate click handler for "which row
  // did I land on": the row a click lands on is, by the time the click
  // fires, already the selected one, and clicking its real <a href> just
  // navigates natively. A dedicated click handler that only recorded
  // `cursor` would earn nothing on top of that (and was the source of the
  // ctrl/cmd-click desync), so there isn't one.
  list.addEventListener('mouseover', (event) => {
    const item = event.target instanceof Element ? event.target.closest('li') : null;
    if (!item) return;
    const items = Array.from(list.querySelectorAll('li'));
    const index = items.indexOf(item);
    if (index !== -1 && index !== cursor) select(index);
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  // The "close" event fires for every way the dialog can close — Escape,
  // a backdrop click, or a programmatic dialog.close() — so restoring
  // scroll here in one place covers all of them.
  dialog.addEventListener('close', () => {
    input.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    opening = false;
  });
</script>
