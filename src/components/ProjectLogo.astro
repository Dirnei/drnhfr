---
import { Image } from 'astro:assets';
import { projectLogos } from '../lib/project-logos';

interface Props {
  slug: string;
}

const logo = projectLogos[Astro.props.slug];
---
{
  logo && (
    <div class="logo" data-tile={logo.tile}>
      <Image src={logo.src} alt="" width={128} height={128} densities={[1, 2]} />
    </div>
  )
}
<style>
  .logo {
    flex: none;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: var(--logo-width, var(--logo-size, 5.5rem));
    height: var(--logo-height, var(--logo-size, 5.5rem));
    padding: var(--logo-padding, 0.75rem);
    background: var(--logo-tile);
    border: 1px solid var(--hairline);
  }
  .logo[data-tile='dark'] {
    background: var(--logo-tile-dark);
  }
  .logo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
