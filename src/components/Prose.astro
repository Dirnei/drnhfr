---
---
<div class="prose">
  <slot />
</div>
<style is:global>
  .prose {
    max-width: var(--measure);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-body);
  }
  .prose p {
    margin: 0 0 1.1rem;
  }
  .prose h2 {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--red-text);
    line-height: 1.1;
    margin: 2.2rem 0 0.7rem;
  }
  .prose h3 {
    font-size: 0.9rem;
    margin: 1.8rem 0 0.6rem;
  }
  .prose a {
    border-bottom: 1px solid var(--hairline);
  }
  .prose a:hover {
    color: var(--red);
    border-bottom-color: var(--red);
  }
  .prose pre {
    background: var(--code-bg);
    border: 1px solid var(--hairline-soft);
    padding: 0.8rem 0.9rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .prose :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.1rem 0.3rem;
  }
  .prose blockquote {
    margin: 1.4rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--hairline);
    color: var(--text);
  }
</style>
