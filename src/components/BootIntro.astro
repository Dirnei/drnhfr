---
import Logo from './Logo.astro';
import type { Locale } from '../i18n/locales';
import { bootLines, bootTiming } from '../data/boot';
import { computeBootSchedule } from '../lib/boot-timing';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const skipHint = lang === 'de' ? 'esc zum überspringen' : 'esc to skip';
const lines = bootLines(lang);
const timing = bootTiming;
const schedule = computeBootSchedule(timing, lines.length);

// Column width for the "[ TAG ]" markers is derived from the longest tag in
// the data, so a future "WARN" or "ERROR" line still lines up.
const taggedLines = lines.filter((line) => line.tag);
const tagWidth =
  taggedLines.length > 0 ? Math.max(...taggedLines.map((line) => line.tag!.length)) + 2 : 0;
function padTag(tag: string): string {
  const gap = tagWidth - tag.length;
  const left = Math.ceil(gap / 2);
  const right = Math.floor(gap / 2);
  return `${' '.repeat(left)}${tag}${' '.repeat(right)}`;
}
---
<div
  class="intro"
  id="intro"
  aria-hidden="true"
  hidden
  data-line-step-min={timing.lineStepMinMs}
  data-line-step-max={timing.lineStepMaxMs}
  data-logo-hold={timing.logoHoldMs}
  data-fade={timing.fadeMs}
  data-assembly-start={schedule.assemblyStart}
  data-condense-start={schedule.condenseStart}
  data-finish-at={schedule.finishAt}
  data-tag-width={tagWidth}
>
  <div class="boot" id="intro-boot">
    {
      lines.map((line) => (
        <div class="ln" data-hold={line.holdUntilVisible || undefined}>
          {line.tag ? (
            <>
              <span class="tag" data-tag={line.tag}>[{padTag(line.tag)}]</span>
              {' '}
              {line.text}
              {line.holdUntilVisible ? (
                <span class="wait-cue" aria-hidden="true"><i>.</i><i>.</i><i>.</i></span>
              ) : null}
            </>
          ) : (
            line.text
          )}
        </div>
      ))
    }
  </div>
  <div class="tile" id="intro-tile"><Logo size={104} /></div>
  <p class="hint">{skipHint}</p>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink);
  }
  .boot {
    padding: 3rem var(--gutter) 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 2;
    color: var(--text-muted);
    white-space: pre;
  }
  .ln {
    opacity: 0;
  }
  /*
   * Boot-log status markers follow terminal convention, not the site palette:
   * green means success, cyan means informational, and red is reserved for
   * failure. Red for [ OK ] would say the opposite of what it means. This is
   * a quotation of a terminal's own colour language inside the intro, and is
   * the one place on the site where an accent other than --red appears.
   * The default below is deliberately red, so an unrecognised tag (a future
   * FAIL or ERROR) is red without anyone having to remember to add a rule.
   */
  .tag {
    color: var(--red-text);
  }
  .tag[data-tag='OK'] {
    color: var(--boot-ok);
  }
  .tag[data-tag='WAIT'],
  .tag[data-tag='INFO'] {
    color: var(--boot-info);
  }
  .wait-cue {
    display: none;
    margin-left: 0.3em;
  }
  /*
   * Only the parked WAIT line gets the animated cue, and only once the
   * script actually decides to park (see the inline script below) — a
   * visible-tab pass-through never adds .parked, so the line just reads as
   * a normal, brief log entry.
   */
  .ln[data-hold].parked .wait-cue {
    display: inline-block;
  }
  .wait-cue i {
    display: inline-block;
    font-style: normal;
    opacity: 0.2;
    animation: wait-dot 1.4s ease-in-out infinite;
  }
  .wait-cue i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .wait-cue i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes wait-dot {
    0%,
    80%,
    100% {
      opacity: 0.2;
    }
    40% {
      opacity: 1;
    }
  }
  .tile {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }
  .hint {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
</style>

<script is:inline>
  // Synchronous (not type="module") and placed right after the markup
  // above: it runs the instant the parser reaches this point, before the
  // rest of the page (header, main, list rows) is even parsed. That
  // matters because the row-stagger CSS is gated on `data-intro="running"`
  // being present on <html> — setting it any later (e.g. from a deferred
  // module script) would leave a window where later elements paint before
  // the marker exists, letting their entrance animation start early.
  const KEY = 'intro-played';
  const root = document.getElementById('intro');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Guarded the same way as the write below: sessionStorage.getItem can
  // throw in private browsing, when storage is blocked, or over quota.
  let seen = false;
  try {
    seen = sessionStorage.getItem(KEY) === '1';
  } catch {
    // Not fatal: worst case the intro plays again on this load.
  }

  if (!root || reduced || seen) {
    root?.remove();
  } else {
    // Timing constants come from the boot log data (src/data/boot.json) via
    // data attributes set from src/lib/boot-timing.ts's computeBootSchedule()
    // in the frontmatter above, so editing the data reshapes the sequence
    // without this script needing its own copy of boot.json. The schedule
    // itself (when each phase fires) is still computed here for the part of
    // the sequence after the holdUntilVisible line, since that part's start
    // time depends on when the visitor actually arrives — see
    // resumeAfterHold() below.
    const lineStepMinMs = Number(root.dataset.lineStepMin);
    const lineStepMaxMs = Number(root.dataset.lineStepMax);
    const logoHoldMs = Number(root.dataset.logoHold);
    const fadeMs = Number(root.dataset.fade);

    root.hidden = false;
    document.body.style.overflow = 'hidden';
    document.documentElement.dataset.intro = 'running';

    const timers = [];
    const at = (ms, fn) => timers.push(window.setTimeout(fn, ms));

    // Set while the sequence is parked on the holdUntilVisible line, so
    // finish() (dismissal) can tear it down even if the visitor never
    // switches back to this tab.
    let onHoldVisible = null;

    function onKeydown(event) {
      if (event.key === 'Escape') finish();
    }

    const finish = () => {
      timers.forEach(clearTimeout);
      document.removeEventListener('keydown', onKeydown);
      if (onHoldVisible) {
        document.removeEventListener('visibilitychange', onHoldVisible);
        onHoldVisible = null;
      }
      document.body.style.overflow = '';
      delete document.documentElement.dataset.intro;
      root.style.transition = `opacity ${fadeMs}ms ease`;
      root.style.opacity = '0';
      window.setTimeout(() => root.remove(), fadeMs);
      document.dispatchEvent(new CustomEvent('intro:finished', { bubbles: true }));
      // Written here, at actual completion or dismissal — not at intro
      // start — so a tab that parks on the holdUntilVisible line and is
      // never switched to does not burn the "seen this session" flag.
      // Guarded like the read above: setItem can throw in private
      // browsing, when storage is blocked, or over quota.
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        // Not fatal: worst case the intro replays on the next load.
      }
    };

    // Wire every exit route — the natural end-of-sequence timer (scheduled
    // below, once the schedule is known) and all four dismissal listeners —
    // before scheduling the rest of the visual choreography. Everything
    // from here down is just line-reveal and logo-assembly styling; if any
    // of it throws, the intro can still be dismissed and the `data-intro`
    // marker can still be cleared, instead of getting stuck forever with no
    // way to reach finish().
    const lines = Array.from(root.querySelectorAll('.ln'));
    const holdLine = root.querySelector('.ln[data-hold]');
    const holdIndex = holdLine ? lines.indexOf(holdLine) : -1;

    document.addEventListener('keydown', onKeydown);
    root.addEventListener('click', finish);
    window.addEventListener('wheel', finish, { once: true, passive: true });
    window.addEventListener('touchmove', finish, { once: true, passive: true });

    function revealLine(line) {
      // The fade-in itself stays a fixed, snappy length — it's the *gap*
      // between reveals (rollStep(), below) that is irregular, not the
      // reveal animation each line plays when its turn comes.
      line.style.transition = `opacity ${lineStepMinMs}ms`;
      line.style.opacity = '1';
    }

    // Mirrors rollLineStepMs() in src/lib/boot-timing.ts. Duplicated here
    // because this script is intentionally non-module (see the comment at
    // the top of this file) and so cannot import it — keep both in sync if
    // the formula ever changes.
    function rollStep() {
      return Math.round(lineStepMinMs + Math.random() * (lineStepMaxMs - lineStepMinMs));
    }

    // Rolls `count` cumulative reveal times: the first is always 0 (a line
    // reveals immediately once its turn starts), and each subsequent one
    // adds a freshly rolled, independent step — the irregular rhythm that
    // replaces the old constant `index * lineStepMs`.
    function rollCumulativeTimes(count) {
      const times = [];
      let elapsed = 0;
      for (let i = 0; i < count; i++) {
        if (i > 0) elapsed += rollStep();
        times.push(elapsed);
      }
      return times;
    }

    const boot = document.getElementById('intro-boot');
    const tile = document.getElementById('intro-tile');

    function assembleLogo() {
      if (boot) {
        boot.style.transition = `opacity ${fadeMs}ms`;
        boot.style.opacity = '0';
      }
      if (tile) {
        tile.style.transition = `opacity ${fadeMs}ms`;
        tile.style.opacity = '1';
      }
    }

    function condenseLogo() {
      if (tile) {
        tile.style.transition = `transform ${fadeMs}ms cubic-bezier(.5,0,.2,1), opacity ${fadeMs}ms ease`;
        tile.style.transform = 'scale(.27)';
        tile.style.opacity = '0';
      }
    }

    // Rewrites the parked line's tag from WAIT to OK, reusing the same
    // centered-padding rule the Astro frontmatter used to build it, so the
    // "[ TAG ]" column stays aligned.
    function flipHoldTag() {
      const tagWidth = Number(root.dataset.tagWidth);
      const tag = holdLine.querySelector('.tag');
      if (!tag || !tagWidth) return;
      const gap = tagWidth - 'OK'.length;
      const left = ' '.repeat(Math.ceil(gap / 2));
      const right = ' '.repeat(Math.floor(gap / 2));
      tag.textContent = `[${left}OK${right}]`;
    }

    // Schedules everything after the holdUntilVisible line — remaining
    // lines, logo assembly, condense, finish — relative to *now*, i.e. the
    // moment the hold condition is satisfied (either immediately, if the
    // tab was already visible when the sequence reached that line, or on
    // the visibilitychange that ends a park). This is the same arithmetic
    // computeBootSchedule() uses, just re-based on "now" instead of script
    // start, treating the already-revealed hold line as that mini
    // sequence's first line.
    function resumeAfterHold() {
      const remaining = lines.slice(holdIndex + 1);
      // times[0] is the (already-revealed) hold line's own position, 0;
      // times[1..] are when each remaining line reveals, relative to now.
      const times = rollCumulativeTimes(remaining.length + 1);
      remaining.forEach((line, index) => at(times[index + 1], () => revealLine(line)));
      const lineRevealMs = times[times.length - 1];
      const assemblyStart = lineRevealMs + logoHoldMs;
      const condenseStart = assemblyStart + fadeMs;
      const finishAt = condenseStart + fadeMs;
      at(assemblyStart, assembleLogo);
      at(condenseStart, condenseLogo);
      at(finishAt, finish);
    }

    if (holdIndex === -1) {
      // Defensive fallback if boot.json ever ships without a
      // holdUntilVisible line: behave exactly as before, using the
      // schedule computed at build time from the full line count.
      // Worst-case data attributes: safe even though the rolled reveal
      // times below can only be equal to or shorter than this bound.
      const assemblyStart = Number(root.dataset.assemblyStart);
      const condenseStart = Number(root.dataset.condenseStart);
      const finishAt = Number(root.dataset.finishAt);
      const times = rollCumulativeTimes(lines.length);
      lines.forEach((line, index) => at(times[index], () => revealLine(line)));
      at(assemblyStart, assembleLogo);
      at(condenseStart, condenseLogo);
      at(finishAt, finish);
    } else {
      const times = rollCumulativeTimes(holdIndex + 1);
      lines.slice(0, holdIndex).forEach((line, index) => at(times[index], () => revealLine(line)));

      at(times[holdIndex], () => {
        revealLine(holdLine);
        if (document.hidden) {
          // Park here instead of guessing: the rest of the sequence would
          // run unseen, and background-tab timer throttling would mangle
          // it anyway. The cue makes the pause read as "waiting", not
          // "stuck".
          holdLine.classList.add('parked');
          onHoldVisible = () => {
            if (document.hidden) return;
            document.removeEventListener('visibilitychange', onHoldVisible);
            onHoldVisible = null;
            holdLine.classList.remove('parked');
            flipHoldTag();
            resumeAfterHold();
          };
          document.addEventListener('visibilitychange', onHoldVisible);
        } else {
          // Already visible: pass straight through, no delay — the common
          // case must not be slowed down by this line's existence.
          resumeAfterHold();
        }
      });
    }
  }
</script>
