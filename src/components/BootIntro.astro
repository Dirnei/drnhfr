---
import Logo from './Logo.astro';
import type { Locale } from '../i18n/locales';
import { bootLines, bootTiming } from '../data/boot';
import { computeBootSchedule } from '../lib/boot-timing';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const skipHint = lang === 'de' ? 'esc zum überspringen' : 'esc to skip';
const lines = bootLines(lang);
const timing = bootTiming;
const schedule = computeBootSchedule(timing, lines.length);

// Column width for the "[ TAG ]" markers is derived from the longest tag in
// the data, so a future "WARN" or "ERROR" line still lines up.
const taggedLines = lines.filter((line) => line.tag);
const tagWidth =
  taggedLines.length > 0 ? Math.max(...taggedLines.map((line) => line.tag!.length)) + 2 : 0;
function padTag(tag: string): string {
  const gap = tagWidth - tag.length;
  const left = Math.ceil(gap / 2);
  const right = Math.floor(gap / 2);
  return `${' '.repeat(left)}${tag}${' '.repeat(right)}`;
}
---
<div
  class="intro"
  id="intro"
  aria-hidden="true"
  hidden
  data-line-step={timing.lineStepMs}
  data-fade={timing.fadeMs}
  data-assembly-start={schedule.assemblyStart}
  data-condense-start={schedule.condenseStart}
  data-finish-at={schedule.finishAt}
>
  <div class="boot" id="intro-boot">
    {
      lines.map((line) => (
        <div class="ln">
          {line.tag ? (
            <>
              <span class="tag">[{padTag(line.tag)}]</span>
              {' '}
              {line.text}
            </>
          ) : (
            line.text
          )}
        </div>
      ))
    }
  </div>
  <div class="tile" id="intro-tile"><Logo size={104} /></div>
  <p class="hint">{skipHint}</p>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink);
  }
  .boot {
    padding: 3rem var(--gutter) 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 2;
    color: var(--text-muted);
    white-space: pre;
  }
  .ln {
    opacity: 0;
  }
  .tag {
    color: var(--red-text);
  }
  .tile {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }
  .hint {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
</style>

<script is:inline>
  // Synchronous (not type="module") and placed right after the markup
  // above: it runs the instant the parser reaches this point, before the
  // rest of the page (header, main, list rows) is even parsed. That
  // matters because the row-stagger CSS is gated on `data-intro="running"`
  // being present on <html> — setting it any later (e.g. from a deferred
  // module script) would leave a window where later elements paint before
  // the marker exists, letting their entrance animation start early.
  const KEY = 'intro-played';
  const root = document.getElementById('intro');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Guarded the same way as the write below: sessionStorage.getItem can
  // throw in private browsing, when storage is blocked, or over quota.
  let seen = false;
  try {
    seen = sessionStorage.getItem(KEY) === '1';
  } catch {
    // Not fatal: worst case the intro plays again on this load.
  }

  if (!root || reduced || seen) {
    root?.remove();
  } else {
    // Timing comes from the boot log data (src/data/boot.json) via
    // src/lib/boot-timing.ts's computeBootSchedule(), run once at build time
    // in the frontmatter above — not recomputed here — so editing the data
    // reshapes the sequence without this script needing its own copy of the
    // arithmetic.
    const lineStepMs = Number(root.dataset.lineStep);
    const fadeMs = Number(root.dataset.fade);
    const assemblyStart = Number(root.dataset.assemblyStart);
    const condenseStart = Number(root.dataset.condenseStart);
    const finishAt = Number(root.dataset.finishAt);

    root.hidden = false;
    document.body.style.overflow = 'hidden';
    document.documentElement.dataset.intro = 'running';

    const timers = [];
    const at = (ms, fn) => timers.push(window.setTimeout(fn, ms));

    function onKeydown(event) {
      if (event.key === 'Escape') finish();
    }

    const finish = () => {
      timers.forEach(clearTimeout);
      document.removeEventListener('keydown', onKeydown);
      document.body.style.overflow = '';
      delete document.documentElement.dataset.intro;
      root.style.transition = `opacity ${fadeMs}ms ease`;
      root.style.opacity = '0';
      window.setTimeout(() => root.remove(), fadeMs);
      document.dispatchEvent(new CustomEvent('intro:finished', { bubbles: true }));
    };

    // Wire every exit route — the natural end-of-sequence timer and all
    // four dismissal listeners — before scheduling the rest of the visual
    // choreography below. Everything from here down is just line-reveal
    // and logo-assembly styling; if any of it throws, the intro can still
    // be dismissed and the `data-intro` marker can still be cleared,
    // instead of getting stuck forever with no way to reach finish().
    const lines = root.querySelectorAll('.ln');
    at(finishAt, finish);

    document.addEventListener('keydown', onKeydown);
    root.addEventListener('click', finish);
    window.addEventListener('wheel', finish, { once: true, passive: true });
    window.addEventListener('touchmove', finish, { once: true, passive: true });

    // sessionStorage.setItem can throw (private browsing, quota, storage
    // blocked) — kept after every exit route is wired so a throw here still
    // leaves the intro dismissible and the natural end-of-sequence timer
    // still able to clear the marker.
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {
      // Not fatal: worst case the intro replays on the next load.
    }

    lines.forEach((line, index) =>
      at(index * lineStepMs, () => {
        line.style.transition = `opacity ${lineStepMs}ms`;
        line.style.opacity = '1';
      }),
    );

    const boot = document.getElementById('intro-boot');
    const tile = document.getElementById('intro-tile');

    at(assemblyStart, () => {
      if (boot) {
        boot.style.transition = `opacity ${fadeMs}ms`;
        boot.style.opacity = '0';
      }
      if (tile) {
        tile.style.transition = `opacity ${fadeMs}ms`;
        tile.style.opacity = '1';
      }
    });
    at(condenseStart, () => {
      if (tile) {
        tile.style.transition = `transform ${fadeMs}ms cubic-bezier(.5,0,.2,1), opacity ${fadeMs}ms ease`;
        tile.style.transform = 'scale(.27)';
        tile.style.opacity = '0';
      }
    });
  }
</script>
