---
import type { Locale } from '../i18n/locales';
import { routePath, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
  current?: RouteKey;
  altHref: string;
  altAvailable?: boolean;
}

const { lang, current, altHref, altAvailable = true } = Astro.props;
const t = useTranslations(lang);
// 'cv' is deliberately not in this list: it is unlisted-but-not-gone, and
// gets its own entry below which ships hidden and is revealed once the
// visitor has run the terminal's "su" command. The server cannot know
// whether that happened, so the locked state is what it renders.
const items: RouteKey[] = ['projects', 'blog', 'contact'];
---
<ul class="nav-list">
  {
    items.map((key) => (
      <li>
        <a
          href={routePath(key, lang)}
          class={current === key ? 'on' : ''}
          aria-current={current === key ? 'page' : undefined}
        >
          {t(`nav.${key}`)}
        </a>
      </li>
    ))
  }
  <li id="nav-cv" hidden>
    <a
      href={routePath('cv', lang)}
      class={current === 'cv' ? 'on' : ''}
      aria-current={current === 'cv' ? 'page' : undefined}
    >
      {t('nav.cv')}
    </a>
  </li>
  <li><LangSwitch lang={lang} href={altHref} available={altAvailable} /></li>
</ul>
<script is:inline>
  // Reveal the cv link if this session has unlocked it. Same sessionStorage
  // key the terminal and the cv page use, and the same posture: no flag, or
  // no JS at all, means the link stays unlisted.
  try {
    if (sessionStorage.getItem('cv-unlocked') === '1') {
      document.getElementById('nav-cv').hidden = false;
    }
  } catch {
    // Not fatal: the cv stays unlisted for this visit.
  }
</script>
<style>
  .nav-list {
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }
  /* The UA [hidden] rule is not !important everywhere; say it outright. */
  .nav-list li[hidden] {
    display: none;
  }
  .nav-list a {
    color: var(--text-muted);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .nav-list a:hover,
  .nav-list a.on {
    color: var(--text);
    border-bottom-color: var(--red);
  }
  /*
   * Tightens the gap once the nav has wrapped onto its own row (see
   * BaseLayout's .header-inner breakpoint) so the five items sit
   * comfortably in the narrower single row instead of running right up
   * to the edge of what fits.
   */
  @media (max-width: 37.5rem) {
    .nav-list {
      gap: 0.6rem;
      flex-wrap: wrap;
    }
  }
</style>
