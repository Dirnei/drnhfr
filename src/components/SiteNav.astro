---
import type { Locale } from '../i18n/locales';
import { routePath, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
  current?: RouteKey;
  altHref: string;
  altAvailable?: boolean;
}

const { lang, current, altHref, altAvailable = true } = Astro.props;
const t = useTranslations(lang);
const items: RouteKey[] = ['projects', 'blog', 'cv', 'contact'];
---
<ul class="nav-list">
  {
    items.map((key) => (
      <li>
        <a
          href={routePath(key, lang)}
          class={current === key ? 'on' : ''}
          aria-current={current === key ? 'page' : undefined}
        >
          {t(`nav.${key}`)}
        </a>
      </li>
    ))
  }
  <li><LangSwitch lang={lang} href={altHref} available={altAvailable} /></li>
</ul>
<style>
  .nav-list {
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }
  .nav-list a {
    color: var(--text-muted);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .nav-list a:hover,
  .nav-list a.on {
    color: var(--text);
    border-bottom-color: var(--red);
  }
  /*
   * Tightens the gap once the nav has wrapped onto its own row (see
   * BaseLayout's .header-inner breakpoint) so the five items sit
   * comfortably in the narrower single row instead of running right up
   * to the edge of what fits.
   */
  @media (max-width: 37.5rem) {
    .nav-list {
      gap: 0.6rem;
      flex-wrap: wrap;
    }
  }
</style>
