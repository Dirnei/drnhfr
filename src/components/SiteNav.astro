---
import type { Locale } from '../i18n/locales';
import { routePath, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import publicData from '../data/ctf/public.json';
import { doorHref } from '../lib/ctf/paths';

interface Props {
  lang: Locale;
  current?: RouteKey;
  altHref: string;
  altAvailable?: boolean;
}

const { lang, current, altHref, altAvailable = true } = Astro.props;
const t = useTranslations(lang);
const items = ['projects', 'skills', 'contact'] as const satisfies RouteKey[];
---
<ul class="nav-list">
  {
    items.map((key) => (
      <li>
        <a
          href={routePath(key, lang)}
          class={current === key ? 'on' : ''}
          aria-current={current === key ? 'page' : undefined}
        >
          {t(`nav.${key}`)}
        </a>
      </li>
    ))
  }
  <li id="nav-cv" hidden>
    <a
      href={routePath('cv', lang)}
      class={current === 'cv' ? 'on' : ''}
      aria-current={current === 'cv' ? 'page' : undefined}
    >
      {t('nav.cv')}
    </a>
  </li>
  <li class="ctf-menu" id="nav-ctf" hidden>
    <button type="button" class="ctf-toggle" aria-expanded="false" aria-controls="ctf-panel">
      {t('nav.ctf')}
    </button>
    <ul class="ctf-panel" id="ctf-panel" hidden>
      {
        publicData.doors.map((door) => (
          <li data-ctf-nav={door}>
            <a href={doorHref(lang, door)} hidden />
            <button type="button" class="ctf-locked" aria-label={t('nav.ctfLocked')}>
              ?????
            </button>
            <span class="ctf-flash" aria-hidden="true">LOCKED</span>
          </li>
        ))
      }
    </ul>
  </li>
  <li><LangSwitch lang={lang} href={altHref} available={altAvailable} /></li>
</ul>
<script is:inline>
  try {
    if (sessionStorage.getItem('cv-unlocked') === '1') {
      document.getElementById('nav-cv').hidden = false;
    }
  } catch {
    // Not fatal: the cv stays unlisted for this visit.
  }
</script>
<style>
  .nav-list {
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }
  /* The UA [hidden] rule is not !important everywhere; say it outright. */
  .nav-list li[hidden] {
    display: none;
  }
  .nav-list a {
    color: var(--text-muted);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .nav-list a:hover,
  .nav-list a.on {
    color: var(--text);
    border-bottom-color: var(--red);
  }
  .ctf-menu {
    position: relative;
  }
  .ctf-menu button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
  }
  .ctf-toggle {
    color: var(--text-muted);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .ctf-toggle::after {
    content: ' +';
  }
  .ctf-toggle[aria-expanded='true']::after {
    content: ' -';
  }
  .ctf-toggle:hover,
  .ctf-toggle:focus-visible,
  .ctf-toggle.on {
    color: var(--text);
    border-bottom-color: var(--red);
  }
  .ctf-panel {
    position: absolute;
    top: calc(100% + 0.9rem);
    right: 0;
    z-index: 20;
    min-width: 12rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    border: 1px solid var(--hairline);
  }
  .ctf-panel[hidden] {
    display: none;
  }
  .ctf-panel li {
    position: relative;
    padding-block: 0.3rem;
    white-space: nowrap;
  }
  .ctf-panel a[hidden],
  .ctf-panel button[hidden] {
    display: none;
  }
  .ctf-locked {
    color: var(--text-dim);
  }
  .ctf-locked:hover,
  .ctf-locked:focus-visible {
    color: var(--text-muted);
  }
  .ctf-flash {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--red-text);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    opacity: 0;
    pointer-events: none;
  }
  .ctf-flash.show {
    animation: ctf-locked 1.1s ease-out forwards;
  }
  @keyframes ctf-locked {
    0% {
      opacity: 0;
      letter-spacing: 0.9em;
    }
    12% {
      opacity: 1;
      letter-spacing: 0.3em;
    }
    20%,
    32% {
      transform: translate(-2px, -50%);
    }
    26%,
    38% {
      transform: translate(2px, -50%);
    }
    44% {
      opacity: 1;
      transform: translate(0, -50%);
    }
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctf-flash.show {
      animation: ctf-locked-fade 1.1s ease-out forwards;
    }
    @keyframes ctf-locked-fade {
      0%,
      40% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
  }
  .ctf-panel > li:has(.ctf-flash.show) > .ctf-locked {
    visibility: hidden;
  }
  @media (max-width: 37.5rem) {
    .nav-list {
      gap: 0.6rem;
      flex-wrap: wrap;
    }
  }
</style>
