---
import type { Locale } from '../i18n/locales';
import { otherLocale } from '../i18n/locales';
import { routePath, routeSegments } from '../i18n/routes';
import { bootTiming, bootLines } from '../data/boot';
import { INTRO_KEY, STATE_KEY } from '../lib/terminal/unlock';
import { copy } from '../lib/terminal/copy';
import { lastCommitIso } from '../lib/build-info';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cvHref = routePath('cv', lang);
const homeHref = `/${lang}/`;
const otherHomeHref = `/${otherLocale(lang)}/`;
const searchHref = `/${lang}/search.json`;
const terminalLabel = 'Interactive terminal';
const logLabel = lang === 'de' ? 'Terminal-Ausgabe' : 'Terminal output';
const resizeLabel = lang === 'de' ? 'Höhe des Terminals ändern' : 'Resize the terminal';
const inputLabel = 'Terminal input';
const toggleLabel = lang === 'de' ? 'Terminal-Ausgabe ein- oder ausblenden' : 'Show or hide terminal output';

const config = {
  lang,
  cvHref,
  cvAliases: Object.values(routeSegments.cv),
  homeHref,
  otherHomeHref,
  searchHref,
  boot: { ...bootTiming, lines: bootLines },
  lastCommit: lastCommitIso,
};
const nl = String.fromCharCode(10);
const logoBar = '='.repeat(Math.max(...copy.logo.map((row) => row.length)));
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<section class="terminal" id="terminal" lang="en" aria-label={terminalLabel}>
  <div class="term-inner">
    <div class="term-drawer">
      <div class="term-resize" id="terminal-resize" role="separator" aria-orientation="horizontal" aria-label={resizeLabel} tabindex="0"></div>
      <div class="term-titlebar">
        <span class="term-title" aria-hidden="true">drnhfr-sh</span>
        <button
          type="button"
          class="term-toggle"
          id="terminal-toggle"
          aria-controls="terminal-body"
          aria-expanded="false"
          aria-label={toggleLabel}
        ></button>
      </div>
      <div class="term-body" id="terminal-body">
        <div class="term-body-clip">
          <div class="log" id="terminal-log" role="log" aria-live="polite" aria-relevant="additions" aria-label={logLabel}>
            <p class="line art motd logo-art" aria-hidden="true"><span class="bar">{logoBar}</span>{nl}{copy.logo.join(nl)}{nl}<span class="bar">{logoBar}</span></p>
            <p class="line hint motd">{copy.motd.join(nl)}</p>
          </div>
        </div>
      </div>
    </div>
    <script is:inline define:vars={{ introKey: INTRO_KEY, stateKey: STATE_KEY }}>
      (() => {
        const terminal = document.getElementById('terminal');
        let played = true;
        let open = false;
        try {
          played = sessionStorage.getItem(introKey) === '1';
          open = JSON.parse(sessionStorage.getItem(stateKey) ?? '{}').open === true;
        } catch {
          // Storage blocked or state unreadable: skip the boot log, start closed.
        }
        if (open) terminal.dataset.open = '';
        if (!played) {
          terminal.dataset.boot = '';
          terminal.dataset.open = '';
        }
      })();
    </script>
    <form class="term-form" id="terminal-form">
      <label for="terminal-input" class="visually-hidden">{inputLabel}</label>
      <span class="seg seg-err" id="terminal-status" hidden aria-hidden="true">&#10007;</span>
      <span class="seg seg-time" id="terminal-clock" aria-hidden="true">--:--</span>
      <span class="seg seg-host" id="terminal-host" aria-hidden="true">{copy.promptUser}</span>
      <span class="seg seg-path" aria-hidden="true">~</span>
      <span class="seg seg-lang" aria-hidden="true">{lang}</span>
      <span class="seg seg-lock" id="terminal-lock" hidden aria-hidden="true">cv unlocked</span>
      <span class="seg-cap" aria-hidden="true"></span>
      <input
        type="text"
        id="terminal-input"
        class="term-input"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        disabled
      />
    </form>
  </div>
</section>

<style>
  .terminal {
    position: relative;
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .term-inner {
    position: relative;
  }
  @media (max-width: 37.5rem) {
    .terminal {
      display: none;
    }
  }
  .term-drawer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
  }
  .terminal[data-boot] .term-drawer {
    bottom: 0;
  }
  .term-resize {
    position: absolute;
    top: -4px;
    left: 0;
    right: 0;
    z-index: 1;
    height: 9px;
    cursor: ns-resize;
    touch-action: none;
  }
  .term-resize:hover,
  .term-resize:focus-visible {
    outline: none;
    background: linear-gradient(var(--red), var(--red)) center / 100% 2px no-repeat;
  }
  .terminal:not([data-open]) .term-resize,
  .terminal[data-boot] .term-resize {
    display: none;
  }
  .term-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface);
    border-top: 1px solid var(--hairline);
    padding-left: 0.75rem;
  }
  .term-title {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
  }
  .term-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .terminal[data-open] .term-body {
    grid-template-rows: 1fr;
  }
  .term-body-clip {
    min-height: 0;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 85%, transparent);
    backdrop-filter: blur(6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .term-body {
      transition: none;
    }
  }
  .terminal[data-boot] .term-form,
  .terminal[data-boot] .term-toggle {
    visibility: hidden;
  }

  .log {
    padding: 1rem;
    height: var(--log-height, min(24rem, 50dvh));
    max-height: calc(100dvh - 10rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
  }
  .log :global(.line) {
    margin: 0 0 0.4rem;
  }
  .log :global(.line.art) {
    white-space: pre;
    word-break: normal;
    line-height: 1;
    letter-spacing: 0;
  }
  .log :global(.line.draw) {
    white-space: pre;
    word-break: normal;
    overflow: hidden;
    line-height: 1.15;
  }
  .log :global(.line:last-child) {
    margin-bottom: 0;
  }
  .log :global(.line.hint) {
    color: var(--text-dim);
  }
  .log :global(.line.echo) {
    color: var(--text-muted);
  }
  .log :global(.line.echo .prompt-mini) {
    color: var(--boot-info);
    margin-right: 0.4em;
  }
  .log :global(.line.err) {
    color: var(--red-text);
  }
  .logo-art {
    margin-bottom: 1rem;
    color: var(--text);
  }
  .logo-art .bar {
    color: var(--text-dim);
  }
  .terminal[data-boot] .motd {
    display: none;
  }
  .log :global(.line.boot) {
    margin: 0;
    color: var(--text-muted);
  }
  .log :global(.boot .tag) {
    color: var(--red-text);
  }
  .log :global(.boot .tag[data-tag='OK']) {
    color: var(--boot-ok);
  }
  .log :global(.boot .tag[data-tag='WAIT']),
  .log :global(.boot .tag[data-tag='INFO']) {
    color: var(--boot-info);
  }
  .log :global(.wait-cue) {
    margin-left: 0.3em;
  }
  .log :global(.wait-cue i) {
    font-style: normal;
    opacity: 0.2;
    animation: wait-dot 1.4s ease-in-out infinite;
  }
  .log :global(.wait-cue i:nth-child(2)) {
    animation-delay: 0.2s;
  }
  .log :global(.wait-cue i:nth-child(3)) {
    animation-delay: 0.4s;
  }
  @keyframes wait-dot {
    0%,
    80%,
    100% {
      opacity: 0.2;
    }
    40% {
      opacity: 1;
    }
  }
  .term-form {
    display: flex;
    align-items: stretch;
    gap: 0;
    border-top: 1px solid var(--hairline);
    --prev: transparent;
  }

  .seg {
    position: relative;
    display: inline-flex;
    margin: 0;
    align-items: center;
    flex: none;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.55rem 0.3rem 0.85rem;
    white-space: nowrap;
  }
  .seg[hidden] {
    display: none;
  }
  .seg::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: calc(0.5em + 1px);
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
  }
  /* Leads the row when it shows, so nothing sits behind it to wedge into. */
  .seg-err {
    --bg: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --prev: transparent;
    --fg: var(--red-text);
    padding-left: 0.7rem;
  }
  .seg-time {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --fg: var(--boot-info);
    font-variant-numeric: tabular-nums;
  }
  /* Usual case: no error, so the clock leads the row instead. */
  .seg-err[hidden] + .seg-time {
    --prev: transparent;
    padding-left: 0.7rem;
  }
  .seg-host {
    --bg: var(--hairline);
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--text-body);
  }
  .seg-path {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: var(--hairline);
    --fg: var(--text-muted);
  }
  .seg-lang {
    --bg: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--boot-info);
    text-transform: uppercase;
  }
  .seg-lock {
    --bg: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --fg: var(--boot-ok);
  }
  .seg-cap {
    flex: none;
    margin-left: -1px;
    width: calc(0.35rem + 1px);
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
  }
  .seg-lock:not([hidden]) ~ .seg-cap {
    --prev: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
  }
  .term-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .term-input:focus {
    outline: none;
  }
  .term-input:disabled {
    color: var(--text-dim);
  }
  .term-toggle {
    flex: none;
    width: 2.25rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
  }
  .term-toggle::before {
    content: '';
    display: block;
    width: 0.6rem;
    height: 0.35rem;
    margin: 0 auto;
    background: currentColor;
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
  }
  .terminal[data-open] .term-toggle::before {
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .term-toggle:hover,
  .term-toggle:focus-visible {
    color: var(--red-text);
    outline: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script type="application/json" id="terminal-config" is:inline set:html={configJson} />
<script>
  import { boot } from '../lib/terminal/shell';

  boot();
</script>
