---
import type { Locale } from '../i18n/locales';
import { otherLocale } from '../i18n/locales';
import { routePath } from '../i18n/routes';
import { computeBootSchedule, DECODE_FALLBACK_MARGIN_MS } from '../lib/boot-timing';
import { bootTiming, bootLines } from '../data/boot';
import { copy } from '../lib/terminal/copy';
import { lastCommitIso } from '../lib/build-info';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cvHref = routePath('cv', lang);
const otherHomeHref = `/${otherLocale(lang)}/`;
const searchHref = `/${lang}/search.json`;
const introFallbackMs =
  Math.max(
    computeBootSchedule(bootTiming, bootLines('de').length).finishAt,
    computeBootSchedule(bootTiming, bootLines('en').length).finishAt,
  ) + DECODE_FALLBACK_MARGIN_MS;
const terminalLabel = 'Interactive terminal';
const logLabel = lang === 'de' ? 'Terminal-Ausgabe' : 'Terminal output';
const inputLabel = 'Terminal input';

const config = {
  lang,
  cvHref,
  otherHomeHref,
  searchHref,
  introFallbackMs,
  lastCommit: lastCommitIso,
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<section class="terminal" id="terminal" lang="en" aria-label={terminalLabel}>
  <div class="chips" id="terminal-chips">
    {
      copy.chips.map((chip) => (
        <button type="button" class="chip" data-run={chip.run} disabled>
          {chip.label}
        </button>
      ))
    }
  </div>
  <div class="log" id="terminal-log" role="log" aria-live="polite" aria-relevant="additions" aria-label={logLabel}>
    <p class="line hint">{copy.motd.join(String.fromCharCode(10))}</p>
  </div>
  <form class="term-form" id="terminal-form">
    <label for="terminal-input" class="visually-hidden">{inputLabel}</label>
    <span class="seg seg-err" id="terminal-status" hidden aria-hidden="true">&#10007;</span>
    <span class="seg seg-time" id="terminal-clock" aria-hidden="true">--:--</span>
    <span class="seg seg-host" id="terminal-host" aria-hidden="true">{copy.promptUser}</span>
    <span class="seg seg-path" aria-hidden="true">~</span>
    <span class="seg seg-lang" aria-hidden="true">{lang}</span>
    <span class="seg seg-lock" id="terminal-lock" hidden aria-hidden="true">cv unlocked</span>
    <span class="seg-cap" aria-hidden="true"></span>
    <input
      type="text"
      id="terminal-input"
      class="term-input"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      disabled
    />
  </form>
</section>

<style>
  .terminal {
    max-width: var(--page-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    padding-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .chips {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  @media (max-width: 37.5rem) {
    .chips {
      display: flex;
    }
  }
  .chip {
    background: transparent;
    border: 1px solid var(--hairline);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }
  .chip:hover,
  .chip:focus-visible {
    color: var(--red-text);
    border-color: var(--red-text);
  }
  .chip:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  @media (min-height: 45rem) {
    :global(body:has(.terminal)) {
      height: 100dvh;
    }
    :global(main:has(.terminal)) {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      min-height: 0;
    }
    :global(main:has(.terminal)) > * {
      width: 100%;
    }
    :global(main:has(.terminal)) .terminal {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
    }
    :global(main:has(.terminal)) .log {
      flex: 1;
      max-height: none;
    }
  }

  .log {
    border: 1px solid var(--hairline);
    padding: 1rem;
    min-height: 8rem;
    max-height: 24rem;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
  }
  .log :global(.line) {
    margin: 0 0 0.4rem;
  }
  .log :global(.line.art) {
    white-space: pre;
    word-break: normal;
    line-height: 1;
    letter-spacing: 0;
  }
  .log :global(.line.draw) {
    white-space: pre;
    word-break: normal;
    overflow: hidden;
    line-height: 1.15;
  }
  .log :global(.line:last-child) {
    margin-bottom: 0;
  }
  .log :global(.line.hint) {
    color: var(--text-dim);
  }
  .log :global(.line.echo) {
    color: var(--text-muted);
  }
  .log :global(.line.echo .prompt-mini) {
    color: var(--boot-info);
    margin-right: 0.4em;
  }
  .log :global(.line.err) {
    color: var(--red-text);
  }
  .term-form {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--hairline);
    border-top: 0;
    --prev: transparent;
  }

  .seg {
    position: relative;
    display: inline-flex;
    margin: 0;
    align-items: center;
    flex: none;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.55rem 0.3rem 0.85rem;
    white-space: nowrap;
  }
  .seg[hidden] {
    display: none;
  }
  .seg::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: calc(0.5em + 1px);
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
  }
  /* Leads the row when it shows, so nothing sits behind it to wedge into. */
  .seg-err {
    --bg: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --prev: transparent;
    --fg: var(--red-text);
    padding-left: 0.7rem;
  }
  .seg-time {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --fg: var(--boot-info);
    font-variant-numeric: tabular-nums;
  }
  /* Usual case: no error, so the clock leads the row instead. */
  .seg-err[hidden] + .seg-time {
    --prev: transparent;
    padding-left: 0.7rem;
  }
  .seg-host {
    --bg: var(--hairline);
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--text-body);
  }
  .seg-path {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: var(--hairline);
    --fg: var(--text-muted);
  }
  .seg-lang {
    --bg: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--boot-info);
    text-transform: uppercase;
  }
  .seg-lock {
    --bg: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --fg: var(--boot-ok);
  }
  .seg-cap {
    flex: none;
    margin-left: -1px;
    width: calc(0.35rem + 1px);
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
  }
  .seg-lock:not([hidden]) ~ .seg-cap {
    --prev: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
  }
  @media (max-width: 30rem) {
    .seg-path {
      display: none;
    }
    .seg-lang {
      --prev: var(--surface);
    }
  }
  .term-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .term-input:focus {
    outline: none;
  }
  .term-input:disabled {
    color: var(--text-dim);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script type="application/json" id="terminal-config" is:inline set:html={configJson} />
<script>
  import { boot } from '../lib/terminal/shell';

  boot();
</script>
