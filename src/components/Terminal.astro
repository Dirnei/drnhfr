---
import type { Locale } from '../i18n/locales';
import { otherLocale } from '../i18n/locales';
import { routePath } from '../i18n/routes';
import { computeBootSchedule, DECODE_FALLBACK_MARGIN_MS } from '../lib/boot-timing';
import { bootTiming, bootLines } from '../data/boot';
import { copy } from '../lib/terminal/copy';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cvHref = routePath('cv', lang);
const otherHomeHref = `/${otherLocale(lang)}/`;
const searchHref = `/${lang}/search.json`;
// Computed here rather than in the shell so the fallback follows boot.json
// instead of a hard-coded number: a safety timeout in case `intro:finished`
// never fires (e.g. a tab parked on BootIntro's holdUntilVisible line and
// never switched back to).
const introFallbackMs =
  Math.max(
    computeBootSchedule(bootTiming, bootLines('de').length).finishAt,
    computeBootSchedule(bootTiming, bootLines('en').length).finishAt,
  ) + DECODE_FALLBACK_MARGIN_MS;
const terminalLabel = 'Interactive terminal';
const logLabel = lang === 'de' ? 'Terminal-Ausgabe' : 'Terminal output';
const inputLabel = 'Terminal input';

/*
 * Everything the client needs that the server alone knows. It travels as a
 * JSON blob below rather than through define:vars: define:vars forces a
 * script inline, an inline script cannot import, and that single constraint
 * is what used to hold the whole shell and all eleven commands in this file.
 *
 * The strings live in ../lib/terminal/copy.ts, shared with the client.
 */
const config = { lang, cvHref, otherHomeHref, searchHref, introFallbackMs };
// A literal </script> inside the blob would end the tag early. Nothing here
// contains one today, but escaping < costs nothing and removes the class.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<section class="terminal" id="terminal" lang="en" aria-label={terminalLabel}>
  <div class="chips" id="terminal-chips">
    {
      copy.chips.map((chip) => (
        <button type="button" class="chip" data-run={chip.run} disabled>
          {chip.label}
        </button>
      ))
    }
  </div>
  <div class="log" id="terminal-log" role="log" aria-live="polite" aria-relevant="additions" aria-label={logLabel}>
    {/*
      One element, not one per line: the log is white-space: pre-wrap, so the
      blank lines survive as blank lines. Rendered per line they collapsed,
      because an empty <p> has no height, and a message of the day without
      its spacing is just a paragraph.
    */}
    <p class="line hint">{copy.motd.join(String.fromCharCode(10))}</p>
  </div>
  <form class="term-form" id="terminal-form">
    <label for="terminal-input" class="visually-hidden">{inputLabel}</label>
    <span class="seg seg-err" id="terminal-status" hidden aria-hidden="true">&#10007;</span>
    <span class="seg seg-time" id="terminal-clock" aria-hidden="true">--:--</span>
    <span class="seg seg-host" id="terminal-host" aria-hidden="true">{copy.promptUser}</span>
    <span class="seg seg-path" aria-hidden="true">~</span>
    <span class="seg seg-lang" aria-hidden="true">{lang}</span>
    <span class="seg seg-lock" id="terminal-lock" hidden aria-hidden="true">cv unlocked</span>
    <span class="seg-cap" aria-hidden="true"></span>
    <input
      type="text"
      id="terminal-input"
      class="term-input"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      disabled
    />
  </form>
</section>

<style>
  .terminal {
    max-width: var(--page-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    padding-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .chips {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  @media (max-width: 37.5rem) {
    .chips {
      display: flex;
    }
  }
  .chip {
    background: transparent;
    border: 1px solid var(--hairline);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }
  .chip:hover,
  .chip:focus-visible {
    color: var(--red-text);
    border-color: var(--red-text);
  }
  .chip:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .log {
    border: 1px solid var(--hairline);
    padding: 1rem;
    min-height: 8rem;
    max-height: 24rem;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
  }
  /*
   * :global is load-bearing here — do not "tidy" it away.
   *
   * Astro scopes component styles by stamping data-astro-cid-* onto the
   * elements in THIS template at build time. Every line in the log except the
   * first is created by document.createElement in the shell at runtime, so it
   * never receives that attribute and a plain `.line` rule simply misses it.
   *
   * The consequence was silent and long-lived: error lines were not red,
   * echoed commands were not muted, the $ was not teal, and every line used
   * the browser's default 1em <p> margin instead of 0.4rem — which also left
   * a 13px gap under the last line that made the log look like it had failed
   * to scroll to the bottom.
   *
   * Scoped to descendants of .log, which is itself scoped, so this leaks
   * nothing outside the terminal.
   */
  .log :global(.line) {
    margin: 0 0 0.4rem;
  }
  /*
   * A drawing surface, not prose: the log wraps and breaks words, which turns
   * ASCII art into confetti. pre keeps the columns, and the overflow is
   * clipped rather than scrolled so a wide frame cannot make the whole page
   * jiggle sideways mid-animation.
   */
  /*
   * Art keeps its columns and scrolls sideways if it overflows. A banner is
   * worth reaching for; the alternative is the log folding it in half and
   * destroying it.
   */
  /*
   * line-height 1 is not cosmetic here. The banner is drawn out of U+2588
   * FULL BLOCK, which fills its em box exactly — at any line-height above 1
   * the rows stop touching and every letter is sliced into five visible
   * strips. Same reason letter-spacing has to stay at 0.
   */
  /*
   * No overflow of its own. overflow-x: auto here made every banner its own
   * scroll container — and because CSS refuses to pair a scrolling axis with
   * a visible one, overflow-y quietly became auto too, so each block carried
   * its own little scrollbar. The log already scrolls; wide art is its
   * problem to solve, once, for the whole scrollback.
   *
   * line-height 1 is not cosmetic either. The banner is drawn out of U+2588
   * FULL BLOCK, which fills its em box exactly — at any line-height above 1
   * the rows stop touching and every letter is sliced into five visible
   * strips. Same reason letter-spacing has to stay at 0.
   */
  .log :global(.line.art) {
    white-space: pre;
    word-break: normal;
    line-height: 1;
    letter-spacing: 0;
  }
  .log :global(.line.draw) {
    white-space: pre;
    word-break: normal;
    overflow: hidden;
    line-height: 1.15;
  }
  .log :global(.line:last-child) {
    margin-bottom: 0;
  }
  .log :global(.line.hint) {
    color: var(--text-dim);
  }
  .log :global(.line.echo) {
    color: var(--text-muted);
  }
  .log :global(.line.echo .prompt-mini) {
    color: var(--boot-info);
    margin-right: 0.4em;
  }
  .log :global(.line.err) {
    color: var(--red-text);
  }
  /*
   * The prompt row IS the powerline: segments, the closing wedge, then the
   * input running to the end of the row. Nothing is stated twice, and only
   * the input flexes, so the segments never compete with it for width.
   *
   * Clock and error sit at the FRONT rather than the far right. A right-
   * aligned clock needs a flex spacer, and a spacer and a flexing input then
   * fight over the same free space.
   */
  .term-form {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--hairline);
    border-top: 0;
    --prev: transparent;
  }

  /*
   * Segments abut and each one's wedge is drawn in the PREVIOUS segment's
   * colour via --prev, which is what makes a powerline read as one continuous
   * bar rather than detached tabs.
   *
   * The wedge is clip-path, not the usual Nerd Font wedge glyph: that
   * character only exists in patched fonts and this site self-hosts plain
   * JetBrains Mono, so it would render as tofu.
   *
   * Every background is color-mix()'d from existing tokens, so the whole strip
   * follows a palette change rather than drifting from it. Each pairing was
   * measured against WCAG AA: the error segment sits at a 12% red mix rather
   * than the 22% that looked better, because anything stronger dropped red-on-
   * red below 4.5:1.
   *
   * aria-hidden sits on each segment, not on the form: the form holds the
   * input, which has to stay reachable. The segments restate what the page
   * already says, so they are chrome, not content.
   */
  .seg {
    position: relative;
    display: inline-flex;
    margin: 0;
    align-items: center;
    flex: none;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.55rem 0.3rem 0.85rem;
    white-space: nowrap;
  }
  /* .seg sets display, which beats the UA [hidden] rule wherever that rule
     is not !important. Without this the conditional segments show. */
  .seg[hidden] {
    display: none;
  }
  /*
   * The wedge starts one pixel INSIDE the previous segment rather than at
   * this one's edge. Segment boundaries land on fractional pixels, and at
   * left: 0 this segment's own background antialiases into the boundary
   * pixel before the wedge covers it — a hairline of the wrong colour at
   * every arrow. The overlap is painted in the previous segment's own
   * colour, so it is invisible there and covers the sliver here.
   */
  .seg::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: calc(0.5em + 1px);
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
  }
  /* Leads the row when it shows, so nothing sits behind it to wedge into. */
  .seg-err {
    --bg: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --prev: transparent;
    --fg: var(--red-text);
    padding-left: 0.7rem;
  }
  .seg-time {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --fg: var(--boot-info);
    font-variant-numeric: tabular-nums;
  }
  /* Usual case: no error, so the clock leads the row instead. */
  .seg-err[hidden] + .seg-time {
    --prev: transparent;
    padding-left: 0.7rem;
  }
  .seg-host {
    --bg: var(--hairline);
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--text-body);
  }
  .seg-path {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: var(--hairline);
    --fg: var(--text-muted);
  }
  .seg-lang {
    --bg: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--boot-info);
    text-transform: uppercase;
  }
  .seg-lock {
    --bg: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --fg: var(--boot-ok);
  }
  /*
   * The closing wedge. It is a wedge in its own right rather than a segment's
   * ::before, because what follows is the <input>, and a replaced element has
   * no pseudo-elements to hang one on.
   */
  .seg-cap {
    flex: none;
    /*
     * Same one-pixel overlap as .seg::before, and for the same reason: the
     * left edge lands on a fractional pixel and the page ground survives in
     * it as a hairline. A negative margin rather than a negative offset,
     * because this one is a flex item and not a positioned pseudo-element.
     * The overlapped pixel is painted in the previous segment's own colour,
     * so it cannot be seen there.
     */
    margin-left: -1px;
    width: calc(0.35rem + 1px);
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
  }
  .seg-lock:not([hidden]) ~ .seg-cap {
    --prev: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
  }
  /*
   * Phone widths: the tilde carries the least information and goes first,
   * which buys the input about four characters. Dropping it re-points the
   * language segment's wedge at the host colour now behind it.
   */
  @media (max-width: 30rem) {
    .seg-path {
      display: none;
    }
    .seg-lang {
      --prev: var(--surface);
    }
  }
  .term-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .term-input:focus {
    outline: none;
  }
  .term-input:disabled {
    color: var(--text-dim);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script type="application/json" id="terminal-config" is:inline set:html={configJson} />
<script>
  import { boot } from '../lib/terminal/shell';

  boot();
</script>
