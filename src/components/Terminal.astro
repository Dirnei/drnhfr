---
import type { Locale } from '../i18n/locales';
import { otherLocale } from '../i18n/locales';
import { routePath } from '../i18n/routes';
import { computeBootSchedule, DECODE_FALLBACK_MARGIN_MS } from '../lib/boot-timing';
import { bootTiming, bootLines } from '../data/boot';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cvHref = routePath('cv', lang);
const otherHomeHref = `/${otherLocale(lang)}/`;
const searchHref = `/${lang}/search.json`;
// Computed at build time (see DecodeText.astro for the same pattern) so the
// client script below — which uses define:vars and therefore cannot import
// boot-timing.ts itself — still gets a safety-timeout fallback in case
// `intro:finished` never fires (e.g. a tab parked on BootIntro's
// holdUntilVisible line and never switched back to).
const introFallbackMs =
  Math.max(
    computeBootSchedule(bootTiming, bootLines('de').length).finishAt,
    computeBootSchedule(bootTiming, bootLines('en').length).finishAt,
  ) + DECODE_FALLBACK_MARGIN_MS;
const terminalLabel = 'Interactive terminal';
const logLabel = lang === 'de' ? 'Terminal-Ausgabe' : 'Terminal output';
const inputLabel = 'Terminal input';

/*
 * The terminal is English-only by design: its commands are English words,
 * and German help text wrapped around `ls` and `cd` reads as neither one
 * language nor the other. The `lang` prop still drives which search index
 * is fetched and where `cd` navigates, so a German page's terminal still
 * moves around the German site — only the chrome is English.
 */
const copy = {
        promptUser: 'guest@drnhfr',
        introLine: 'type "help" or "?" for a list of commands.',
        reloading: 'reloading …',
        restarting: 'restarting …',
        whoami: 'christian dirnhofer. builds distributed systems for a living, actors and circuit boards for fun.',
        emptyLs: '(empty)',
        cmdNotFoundSuffix: 'command not found',
        catMissing: 'cat: missing operand',
        catNotFoundPrefix: 'cat: no such file: ',
        catNoDescription: 'no description available.',
        cdNotFoundPrefix: 'cd: no such directory: ',
        loginMissing: 'login: please supply a code',
        loginWrong: 'wrong code. nice try.',
        loginSuccess: 'access granted — loading cv …',
        help: [
          'available commands:',
          'help, ?             this list',
          'ls                  list the current directory',
          'cd <target>         move to <target> — ".." and "/" go back',
          'cat <target>        show a short description of <target>',
          'whoami              who built this',
          'lang                switch between /de/ and /en/',
          'clear               clear the screen',
          'login <code>        unlock the cv',
          'reload              reload the page',
          'restart             reboot — replay the boot sequence, re-lock the cv',
        ],
        chips: [
          { label: 'ls', run: 'ls' },
          { label: 'cd blog', run: 'cd blog' },
          { label: 'help', run: 'help' },
        ],
      };
---

<section class="terminal" id="terminal" lang="en" aria-label={terminalLabel}>
  <div class="chips" id="terminal-chips">
    {
      copy.chips.map((chip) => (
        <button type="button" class="chip" data-run={chip.run} disabled>
          {chip.label}
        </button>
      ))
    }
  </div>
  <div class="log" id="terminal-log" role="log" aria-live="polite" aria-relevant="additions" aria-label={logLabel}>
    <p class="line hint">{copy.introLine}</p>
  </div>
  <form class="term-form" id="terminal-form">
    <label for="terminal-input" class="visually-hidden">{inputLabel}</label>
    <span class="seg seg-err" id="terminal-status" hidden aria-hidden="true">&#10007;</span>
    <span class="seg seg-time" id="terminal-clock" aria-hidden="true">--:--</span>
    <span class="seg seg-host" aria-hidden="true">{copy.promptUser}</span>
    <span class="seg seg-path" aria-hidden="true">~</span>
    <span class="seg seg-lang" aria-hidden="true">{lang}</span>
    <span class="seg seg-lock" id="terminal-lock" hidden aria-hidden="true">cv unlocked</span>
    <span class="seg-cap" aria-hidden="true"></span>
    <input
      type="text"
      id="terminal-input"
      class="term-input"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      disabled
    />
  </form>
</section>

<style>
  .terminal {
    max-width: var(--page-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    padding-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .chips {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  @media (max-width: 37.5rem) {
    .chips {
      display: flex;
    }
  }
  .chip {
    background: transparent;
    border: 1px solid var(--hairline);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }
  .chip:hover,
  .chip:focus-visible {
    color: var(--red-text);
    border-color: var(--red-text);
  }
  .chip:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .log {
    border: 1px solid var(--hairline);
    padding: 1rem;
    min-height: 8rem;
    max-height: 24rem;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
  }
  .line {
    margin: 0 0 0.4rem;
  }
  .line:last-child {
    margin-bottom: 0;
  }
  .line.hint {
    color: var(--text-dim);
  }
  .line.echo {
    color: var(--text-muted);
  }
  .line.echo .prompt-mini {
    color: var(--boot-info);
    margin-right: 0.4em;
  }
  .line.err {
    color: var(--red-text);
  }
  /*
   * The prompt row IS the powerline: segments, the closing wedge, then the
   * input running to the end of the row. Nothing is stated twice, and only
   * the input flexes, so the segments never compete with it for width.
   *
   * Clock and error sit at the FRONT rather than the far right. A right-
   * aligned clock needs a flex spacer, and a spacer and a flexing input then
   * fight over the same free space.
   */
  .term-form {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--hairline);
    border-top: 0;
    --prev: transparent;
  }

  /*
   * Segments abut and each one's wedge is drawn in the PREVIOUS segment's
   * colour via --prev, which is what makes a powerline read as one continuous
   * bar rather than detached tabs.
   *
   * The wedge is clip-path, not the usual Nerd Font wedge glyph: that
   * character only exists in patched fonts and this site self-hosts plain
   * JetBrains Mono, so it would render as tofu.
   *
   * Every background is color-mix()'d from existing tokens, so the whole strip
   * follows a palette change rather than drifting from it. Each pairing was
   * measured against WCAG AA: the error segment sits at a 12% red mix rather
   * than the 22% that looked better, because anything stronger dropped red-on-
   * red below 4.5:1.
   *
   * aria-hidden sits on each segment, not on the form: the form holds the
   * input, which has to stay reachable. The segments restate what the page
   * already says, so they are chrome, not content.
   */
  .seg {
    position: relative;
    display: inline-flex;
    margin: 0;
    align-items: center;
    flex: none;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.55rem 0.3rem 0.85rem;
    white-space: nowrap;
  }
  /* .seg sets display, which beats the UA [hidden] rule wherever that rule
     is not !important. Without this the conditional segments show. */
  .seg[hidden] {
    display: none;
  }
  .seg::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0.5em;
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
  }
  /* Leads the row when it shows, so nothing sits behind it to wedge into. */
  .seg-err {
    --bg: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --prev: transparent;
    --fg: var(--red-text);
    padding-left: 0.7rem;
  }
  .seg-time {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: color-mix(in srgb, var(--red-text) 12%, var(--surface));
    --fg: var(--boot-info);
    font-variant-numeric: tabular-nums;
  }
  /* Usual case: no error, so the clock leads the row instead. */
  .seg-err[hidden] + .seg-time {
    --prev: transparent;
    padding-left: 0.7rem;
  }
  .seg-host {
    --bg: var(--hairline);
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--text-body);
  }
  .seg-path {
    --bg: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --prev: var(--hairline);
    --fg: var(--text-muted);
  }
  .seg-lang {
    --bg: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--surface) 55%, var(--ink));
    --fg: var(--boot-info);
    text-transform: uppercase;
  }
  .seg-lock {
    --bg: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
    --fg: var(--boot-ok);
  }
  /*
   * The closing wedge. It is a wedge in its own right rather than a segment's
   * ::before, because what follows is the <input>, and a replaced element has
   * no pseudo-elements to hang one on.
   */
  .seg-cap {
    flex: none;
    width: 0.35rem;
    background: var(--prev);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
    --prev: color-mix(in srgb, var(--boot-info) 16%, var(--surface));
  }
  .seg-lock:not([hidden]) ~ .seg-cap {
    --prev: color-mix(in srgb, var(--boot-ok) 16%, var(--surface));
  }
  /*
   * Phone widths: the tilde carries the least information and goes first,
   * which buys the input about four characters. Dropping it re-points the
   * language segment's wedge at the host colour now behind it.
   */
  @media (max-width: 30rem) {
    .seg-path {
      display: none;
    }
    .seg-lang {
      --prev: var(--surface);
    }
  }
  .term-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .term-input:focus {
    outline: none;
  }
  .term-input:disabled {
    color: var(--text-dim);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script define:vars={{ lang, cvHref, otherHomeHref, searchHref, copy, introFallbackMs }}>
  const UNLOCK_KEY = 'cv-unlocked';

  const section = document.getElementById('terminal');
  const log = document.getElementById('terminal-log');
  const form = document.getElementById('terminal-form');
  const input = document.getElementById('terminal-input');
  const chipsRow = document.getElementById('terminal-chips');
  const chipButtons = Array.from(chipsRow.querySelectorAll('.chip'));

  let entries = [];
  const entriesPromise = fetch(searchHref)
    .then((response) => response.json())
    .then((data) => {
      entries = Array.isArray(data) ? data.filter((entry) => entry.href !== `/${lang}/`) : [];
      return entries;
    })
    .catch(() => {
      entries = [];
      return entries;
    });

  const history = [];
  let historyCursor = 0;
  let draft = '';

  function nameFromHref(href) {
    const trimmed = href.replace(/\/+$/, '');
    const parts = trimmed.split('/').filter(Boolean);
    return parts[parts.length - 1] || '';
  }

  /*
   * `kind` in the search index is a localized label the command palette shows
   * to the visitor; `type` is the stable key. The terminal keys off `type`, so
   * a German index still prints English labels here and nothing breaks if the
   * German wording is ever reworded.
   */
  const TYPE_LABEL = { page: 'Page', project: 'Project', post: 'Article' };
  const TYPE_ORDER = { page: 0, project: 1, post: 2 };

  function isPageType(type) {
    return type === 'page';
  }

  function findEntry(argRaw) {
    const needle = argRaw
      .trim()
      .replace(/^\/+/, '')
      .replace(/\/+$/, '')
      .toLowerCase();
    if (!needle) return undefined;
    return entries.find((entry) => nameFromHref(entry.href).toLowerCase() === needle);
  }

  function appendLine(text, className) {
    const el = document.createElement('p');
    el.className = `line ${className}`;
    el.textContent = text;
    log.append(el);
    log.scrollTop = log.scrollHeight;
  }

  function echo(raw) {
    const el = document.createElement('p');
    el.className = 'line echo';
    const promptSpan = document.createElement('span');
    promptSpan.className = 'prompt-mini';
    promptSpan.setAttribute('aria-hidden', 'true');
    promptSpan.textContent = '$';
    el.append(promptSpan, raw);
    log.append(el);
    log.scrollTop = log.scrollHeight;
  }

  function printOut(text) {
    appendLine(text, 'out');
  }

  let lastFailed = false;

  function printErr(text) {
    lastFailed = true;
    appendLine(text, 'err');
  }

  function cmdLs() {
    if (entries.length === 0) {
      printOut(copy.emptyLs);
      return;
    }
    const rows = entries
      .map((entry) => ({
        name: nameFromHref(entry.href) + (isPageType(entry.type) ? '/' : ''),
        kind: TYPE_LABEL[entry.type] ?? entry.kind,
        type: entry.type,
      }))
      .sort((a, b) => {
        const order = (TYPE_ORDER[a.type] ?? 9) - (TYPE_ORDER[b.type] ?? 9);
        return order !== 0 ? order : a.name.localeCompare(b.name);
      });
    const width = Math.max(...rows.map((row) => row.name.length)) + 2;
    printOut(rows.map((row) => row.name.padEnd(width) + row.kind).join('\n'));
  }

  function cmdCd(arg) {
    const trimmed = arg.trim();
    if (!trimmed || trimmed === '.' || trimmed === '..' || trimmed === '/' || trimmed === '~') {
      // Flat filesystem: there is nowhere to go but here, so this is a
      // silent no-op — exactly what a real shell does with `cd ..` at `/`.
      return;
    }
    const entry = findEntry(trimmed);
    if (!entry) {
      printErr(copy.cdNotFoundPrefix + trimmed);
      return;
    }
    window.location.href = entry.href;
  }

  function cmdCat(arg) {
    const trimmed = arg.trim();
    if (!trimmed) {
      printErr(copy.catMissing);
      return;
    }
    const entry = findEntry(trimmed);
    if (!entry) {
      printErr(copy.catNotFoundPrefix + trimmed);
      return;
    }
    printOut(entry.description || copy.catNoDescription);
  }

  // The unlock code is computed client-side from wall-clock time and the
  // formula lives right here, in plain sight — this is a toy, not access
  // control, see the feature brief. Accepted for the current minute and the
  // one before it, so typing it out doesn't get punished by the clock
  // ticking over mid-keystroke.
  function codeFor(date) {
    const mm = String(date.getMinutes()).padStart(2, '0');
    const hh = String(date.getHours()).padStart(2, '0');
    const yy = String(date.getFullYear() % 100).padStart(2, '0');
    return mm + hh + yy.split('').reverse().join('');
  }

  function cmdLogin(arg) {
    const code = arg.trim();
    if (!code) {
      printErr(copy.loginMissing);
      return;
    }
    const now = new Date();
    const prevMinute = new Date(now.getTime() - 60000);
    if (code === codeFor(now) || code === codeFor(prevMinute)) {
      try {
        sessionStorage.setItem(UNLOCK_KEY, '1');
      } catch {
        // Not fatal: worst case the cv re-locks itself on the next visit.
      }
      printOut(copy.loginSuccess);
      window.location.href = cvHref;
    } else {
      printErr(copy.loginWrong);
    }
  }

  function parse(raw) {
    const trimmed = raw.trim();
    const spaceIndex = trimmed.indexOf(' ');
    if (spaceIndex === -1) return [trimmed, ''];
    return [trimmed.slice(0, spaceIndex), trimmed.slice(spaceIndex + 1)];
  }

  /*
   * reload just reloads. restart is the fun one: it clears the session flags
   * so the boot sequence plays again and the CV re-locks, which is otherwise
   * only possible by opening a private window. Both print a line first and
   * pause briefly so the message is actually readable before the page goes —
   * except under reduced motion, where the pause is pointless theatre.
   */
  function cmdReboot(full) {
    if (full) {
      try {
        sessionStorage.removeItem('intro-played');
        sessionStorage.removeItem(UNLOCK_KEY);
      } catch {
        /* private mode or blocked storage: nothing to clear, reload anyway */
      }
    }
    printOut(full ? copy.restarting : copy.reloading);
    input.disabled = true;
    const settle = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 450;
    window.setTimeout(() => window.location.reload(), settle);
  }

  async function run(raw) {
    echo(raw);
    if (!raw.trim()) return;
    await entriesPromise;
    const [cmdRaw, rest] = parse(raw);
    const cmd = cmdRaw.toLowerCase();
    lastFailed = false;
    switch (cmd) {
      case 'help':
      case '?':
        printOut(copy.help.join('\n'));
        break;
      case 'ls':
        cmdLs();
        break;
      case 'cd':
        cmdCd(rest);
        break;
      case 'cat':
        cmdCat(rest);
        break;
      case 'whoami':
        printOut(copy.whoami);
        break;
      case 'lang':
        window.location.href = otherHomeHref;
        break;
      case 'clear':
        log.replaceChildren();
        break;
      case 'login':
        cmdLogin(rest);
        break;
      case 'reload':
        cmdReboot(false);
        break;
      case 'restart':
        cmdReboot(true);
        break;
      default:
        // Still an error, so the status segment lights up — but a dead end
        // with no way out is worse than a dead end that hands you the map.
        printErr(`${cmdRaw}: ${copy.cmdNotFoundSuffix}`);
        printOut(copy.help.join('\n'));
    }
    stampClock();
    refreshStatus(lastFailed);
  }

  /*
   * Rendered as --:--:-- on the server and filled in on the client: this is a
   * static site, so anything baked in at build time would show the build's
   * clock, not the visitor's.
   */
  const clockEl = document.getElementById('terminal-clock');

  /*
   * Stamped when a prompt is drawn, not ticked on a timer — which is what a
   * real shell does: the prompt shows the time it was printed. No interval,
   * nothing mutating the DOM while the page sits idle.
   */
  function stampClock() {
    if (!clockEl) return;
    const d = new Date();
    const pad = (n) => String(n).padStart(2, '0');
    clockEl.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  stampClock();

  const lockEl = document.getElementById('terminal-lock');
  const statusEl = document.getElementById('terminal-status');

  /* The strip reports real state: whether the last command failed, and
     whether the CV is unlocked this session. Nothing decorative. */
  function refreshStatus(failed) {
    if (statusEl) statusEl.hidden = !failed;
    if (lockEl) {
      let unlocked = false;
      try {
        unlocked = sessionStorage.getItem(UNLOCK_KEY) === '1';
      } catch {
        /* storage blocked: treat as locked */
      }
      lockEl.hidden = !unlocked;
    }
  }

  refreshStatus(false);

  function runFromChip(command) {
    if (input.disabled) return;
    input.value = command;
    form.requestSubmit();
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const raw = input.value;
    input.value = '';
    if (raw.trim()) {
      history.push(raw);
      historyCursor = history.length;
    }
    run(raw);
  });

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowUp') {
      if (history.length === 0) return;
      event.preventDefault();
      if (historyCursor === history.length) draft = input.value;
      historyCursor = Math.max(0, historyCursor - 1);
      input.value = history[historyCursor];
      input.setSelectionRange(input.value.length, input.value.length);
    } else if (event.key === 'ArrowDown') {
      if (history.length === 0) return;
      event.preventDefault();
      historyCursor = Math.min(history.length, historyCursor + 1);
      input.value = historyCursor === history.length ? draft : history[historyCursor];
      input.setSelectionRange(input.value.length, input.value.length);
    } else if (event.key === 'Tab') {
      const value = input.value;
      const spaceIndex = value.indexOf(' ');
      const commands = ['help', 'ls', 'cd', 'cat', 'whoami', 'lang', 'clear', 'login', 'reload', 'restart'];
      if (spaceIndex === -1) {
        const matches = commands.filter((c) => c.startsWith(value.toLowerCase()) && value.length > 0);
        if (matches.length === 1) {
          event.preventDefault();
          input.value = `${matches[0]} `;
        }
      } else {
        const cmd = value.slice(0, spaceIndex).toLowerCase();
        if (cmd === 'cd' || cmd === 'cat') {
          const partial = value.slice(spaceIndex + 1).toLowerCase();
          const matches = entries
            .map((entry) => nameFromHref(entry.href))
            .filter((name, index, all) => all.indexOf(name) === index && name.toLowerCase().startsWith(partial));
          if (matches.length === 1) {
            event.preventDefault();
            input.value = `${cmd} ${matches[0]}`;
          }
        }
      }
    }
  });

  chipButtons.forEach((button) => {
    button.addEventListener('click', () => runFromChip(button.dataset.run ?? ''));
  });

  // Clicking anywhere in the terminal focuses the input, unless the click
  // already landed on something interactive (a chip) that handles itself.
  section.addEventListener('click', (event) => {
    if (input.disabled) return;
    const target = event.target;
    if (target instanceof Element && target.closest('.chip')) return;
    input.focus();
  });

  // Deliberately no autofocus on load (see BaseLayout/Terminal usage): that
  // would pop the keyboard on mobile unprompted and steal a screen-reader
  // user's position. Instead, typing anywhere with nothing else focused
  // focuses the terminal input and lets the keystroke land there.
  document.addEventListener('keydown', (event) => {
    if (input.disabled) return;
    if (document.activeElement !== document.body) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    if (event.key.length !== 1) return;
    // '/' and ctrl/cmd+k are the command palette's global shortcuts — never
    // steal those, even though the guard above already excludes ctrl/cmd+k.
    if (event.key === '/') return;
    input.focus();
  });

  // The prompt only becomes available once the boot intro is done playing —
  // see BootIntro.astro. If the intro isn't running at all (already seen
  // this session, or prefers-reduced-motion), enable immediately.
  if (document.documentElement.dataset.intro === 'running') {
    let enabled = false;
    const enable = () => {
      if (enabled) return;
      enabled = true;
      input.disabled = false;
      chipButtons.forEach((button) => button.removeAttribute('disabled'));
    };
    document.addEventListener('intro:finished', enable, { once: true });
    window.setTimeout(enable, introFallbackMs);
  } else {
    input.disabled = false;
    chipButtons.forEach((button) => button.removeAttribute('disabled'));
  }
</script>
