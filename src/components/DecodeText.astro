---
interface Props {
  text: string;
  delay?: number;
}
const { text, delay = 0 } = Astro.props;
---
<span class="decode" data-text={text} data-delay={delay}>{text}</span>

<script>
  import { computeBootSchedule, DECODE_FALLBACK_MARGIN_MS } from '../lib/boot-timing';
  import { bootTiming, bootLines } from '../data/boot';

  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const DIGITS = '0123456789';

  const pick = (pool: string) => pool[Math.floor(Math.random() * pool.length)];
  const scramble = (ch: string) => {
    if (ch >= 'a' && ch <= 'z') return pick(LOWER);
    if (ch >= 'A' && ch <= 'Z') return pick(UPPER);
    if (ch >= '0' && ch <= '9') return pick(DIGITS);
    return ch;
  };

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const run = () => {
      const elements = [...document.querySelectorAll<HTMLElement>('.decode')];

      const holders = new Map<HTMLElement, number>();
      for (const element of elements) {
        const holder = element.closest<HTMLElement>('h1, h2, h3, p, li') ?? element.parentElement;
        if (holder) holders.set(holder, (holders.get(holder) ?? 0) + 1);
      }
      for (const holder of holders.keys()) {
        holder.style.height = `${holder.getBoundingClientRect().height}px`;
        holder.style.overflow = 'hidden';
      }
      const releaseHolder = (element: HTMLElement) => {
        const holder = element.closest<HTMLElement>('h1, h2, h3, p, li') ?? element.parentElement;
        if (!holder) return;
        const left = (holders.get(holder) ?? 1) - 1;
        holders.set(holder, left);
        if (left > 0) return;
        holder.style.height = '';
        holder.style.overflow = '';
      };

      for (const element of elements) {
        const final = element.dataset.text ?? '';
        const delay = Number(element.dataset.delay ?? 0);
        const duration = 620;
        const start = performance.now() + delay;

        const frame = (now: number) => {
          if (now < start) {
            requestAnimationFrame(frame);
            return;
          }
          const progress = Math.min(1, (now - start) / duration);
          const settled = Math.floor(progress * final.length);
          let out = final.slice(0, settled);
          for (let i = settled; i < final.length; i++) out += scramble(final[i]);
          element.textContent = out;
          if (progress < 1) requestAnimationFrame(frame);
          else releaseHolder(element);
        };

        requestAnimationFrame(frame);
      }
    };

    if (document.documentElement.dataset.intro === 'running') {
      const fallbackMs =
        Math.max(
          computeBootSchedule(bootTiming, bootLines('de').length).finishAt,
          computeBootSchedule(bootTiming, bootLines('en').length).finishAt,
        ) + DECODE_FALLBACK_MARGIN_MS;

      let done = false;
      let timeoutId: number;
      const start = () => {
        if (done) return;
        done = true;
        clearTimeout(timeoutId);
        run();
      };
      document.addEventListener('intro:finished', start, { once: true });

      const armFallback = () => {
        timeoutId = window.setTimeout(start, fallbackMs);
      };
      if (document.visibilityState === 'visible') {
        armFallback();
      } else {
        const onVisible = () => {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', onVisible);
          armFallback();
        };
        document.addEventListener('visibilitychange', onVisible);
      }
    } else {
      run();
    }
  }
</script>
