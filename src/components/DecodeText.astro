---
interface Props {
  text: string;
  delay?: number;
}
const { text, delay = 0 } = Astro.props;
---
<span class="decode" data-text={text} data-delay={delay}>{text}</span>

<script>
  import { computeBootSchedule, DECODE_FALLBACK_MARGIN_MS } from '../lib/boot-timing';
  import { bootTiming, bootLines } from '../data/boot';

  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/\\<>[]{}#*+=-';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const run = () => {
      for (const element of document.querySelectorAll<HTMLElement>('.decode')) {
        const final = element.dataset.text ?? '';
        const delay = Number(element.dataset.delay ?? 0);
        const duration = 620;
        const start = performance.now() + delay;

        const frame = (now: number) => {
          if (now < start) {
            requestAnimationFrame(frame);
            return;
          }
          const progress = Math.min(1, (now - start) / duration);
          const settled = Math.floor(progress * final.length);
          let out = final.slice(0, settled);
          for (let i = settled; i < final.length; i++) {
            out += final[i] === ' ' ? ' ' : CHARS[Math.floor(Math.random() * CHARS.length)];
          }
          element.textContent = out;
          if (progress < 1) requestAnimationFrame(frame);
        };

        requestAnimationFrame(frame);
      }
    };

    // A full-screen boot intro may still be covering the page. Starting the
    // decode now would let it finish unseen underneath the overlay, so wait
    // for the intro to announce completion — with a safety timeout in case
    // the event never arrives. This component doesn't know which locale's
    // intro is running, so the fallback is computed for both and the worse
    // (longer) of the two is used, plus a margin — derived from the same
    // boot-timing.ts arithmetic that drives BootIntro itself, rather than a
    // hard-coded number that a boot.json retune could silently outgrow.
    if (document.documentElement.dataset.intro === 'running') {
      const fallbackMs =
        Math.max(
          computeBootSchedule(bootTiming, bootLines('de').length).finishAt,
          computeBootSchedule(bootTiming, bootLines('en').length).finishAt,
        ) + DECODE_FALLBACK_MARGIN_MS;

      let done = false;
      let timeoutId: number;
      const start = () => {
        if (done) return;
        done = true;
        clearTimeout(timeoutId);
        run();
      };
      document.addEventListener('intro:finished', start, { once: true });

      // The fallback countdown is armed on first visibility, not here at
      // script load: a tab parked in the background (see BootIntro's
      // holdUntilVisible line) can sit hidden far longer than fallbackMs.
      // Arming immediately would trip the fallback unseen, decode the
      // headings under the still-hidden overlay, and then have the intro
      // play over an already-finished page once the visitor arrives.
      const armFallback = () => {
        timeoutId = window.setTimeout(start, fallbackMs);
      };
      if (document.visibilityState === 'visible') {
        armFallback();
      } else {
        const onVisible = () => {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', onVisible);
          armFallback();
        };
        document.addEventListener('visibilitychange', onVisible);
      }
    } else {
      run();
    }
  }
</script>
