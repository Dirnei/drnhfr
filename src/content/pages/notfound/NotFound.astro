---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales } from '../../../i18n/locales';
import { getNotFoundPage } from '../../../lib/entries';

const pages = await Promise.all(
  locales.map(async (locale) => ({ locale, data: (await getNotFoundPage(locale)).data })),
);
const headings = pages.map((page) => page.data.heading).join(' / ');
const descriptions = pages.map((page) => page.data.description).join(' / ');
---
<BaseLayout
  lang="de"
  title="404 — dirnhofer.net"
  description={descriptions}
  altHref="/en/"
  altAvailable={false}
>
  <div class="shell not-found">
    <p class="mono-label code">404</p>
    <h1>{headings}</h1>
    <section>
      {
        pages.map((page) => (
          <p class="mono-label" lang={page.locale}>
            {page.data.line} <a href={`/${page.locale}/`}>{page.data.linkText}</a>.
          </p>
        ))
      }
    </section>
  </div>
</BaseLayout>
<style>
  .not-found {
    padding-block: 4rem 3rem;
  }
  .code {
    color: var(--red-text);
    font-size: 0.8125rem;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 8vw, 3.5rem);
    margin: 0 0 2rem;
  }
  section p {
    margin: 0 0 0.75rem;
  }
  section a {
    border-bottom: 1px solid var(--hairline);
  }
  section a:hover {
    color: var(--red);
    border-bottom-color: var(--red);
  }
</style>
