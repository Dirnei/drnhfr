---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DecodeText from '../../../components/DecodeText.astro';
import CtfFlag from '../../../components/CtfFlag.astro';
import GitStats from '../../../components/GitStats.astro';
import ProjectCarousel from '../../../components/ProjectCarousel.astro';
import Prose from '../../../components/Prose.astro';
import { getCtfPage, getHomePage } from '../../../lib/entries';
import { otherLocale, type Locale } from '../../../i18n/locales';

interface Props {
  lang: Locale;
}

const SLOT_MARKER = /<!-- (git-stats|ctf-flag|projects) -->/;

const { lang } = Astro.props;
const entry = await getHomePage(lang);
const { data } = entry;
const parts = (entry.rendered?.html ?? '').split(SLOT_MARKER);
const ctfPage = await getCtfPage(lang);
const HEADLINE_STEP_MS = 210;
---
<BaseLayout
  lang={lang}
  title={data.title}
  description={data.description}
  altHref={`/${otherLocale(lang)}/`}
>
  <div class="shell hero">
    <p class="mono-label kicker">{data.kicker}</p>
    <h1>
      {
        data.headline.map((line, index) => (
          <>
            {index > 0 && <br />}
            <DecodeText text={line} delay={data.headlineDelay + index * HEADLINE_STEP_MS} />
          </>
        ))
      }
    </h1>
    <p class="sub">
      {
        data.sub.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>
  </div>
  <section class="shell ctf">
    <Prose>
      {
        parts.map((part, index) =>
          index % 2 === 0 ? (
            <Fragment set:html={part} />
          ) : part === 'git-stats' ? (
            <GitStats lang={lang} labels={data.gitStats} />
          ) : part === 'projects' ? (
            <ProjectCarousel lang={lang} />
          ) : (
            <CtfFlag />
          ),
        )
      }
    </Prose>
    <p class="mobile">{ctfPage.data.mobile}</p>
  </section>
</BaseLayout>
<style>
  .hero {
    padding-block: 3rem 1.5rem;
  }
  .kicker {
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-size: clamp(2.5rem, 12vw, 5.5rem);
  }
  .ctf {
    padding-block: 1.5rem 3rem;
  }
  .mobile {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  @media (max-width: 37.5rem) {
    .mobile {
      display: block;
    }
  }
  .ctf :global(.shine) {
    color: transparent;
    background: linear-gradient(
        105deg,
        var(--text) 0 42%,
        var(--text-muted) 46%,
        var(--shine) 50%,
        var(--text-muted) 54%,
        var(--text) 58% 100%
      )
      100% 0 / 400% 100%;
    background-clip: text;
    animation: shine 3.5s ease-in-out infinite;
  }
  @keyframes shine {
    0% {
      background-position: 100% 0;
      filter: none;
    }
    20% {
      filter: drop-shadow(0 0 0.4em color-mix(in srgb, var(--shine) 60%, transparent));
    }
    40%,
    100% {
      background-position: 0 0;
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctf :global(.shine) {
      color: var(--text);
      background: none;
      animation: none;
    }
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 44ch;
    margin-top: 1.25rem;
  }
</style>
