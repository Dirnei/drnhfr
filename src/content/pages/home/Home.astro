---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DecodeText from '../../../components/DecodeText.astro';
import Prose from '../../../components/Prose.astro';
import publicData from '../../../data/ctf/public.json';
import { render } from 'astro:content';
import { getCtfPage, getHomePage } from '../../../lib/entries';
import { otherLocale, type Locale } from '../../../i18n/locales';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const entry = await getHomePage(lang);
const { data } = entry;
const { Content } = await render(entry);
const ctfPage = await getCtfPage(lang);
const HEADLINE_STEP_MS = 210;
---
<BaseLayout
  lang={lang}
  title={data.title}
  description={data.description}
  altHref={`/${otherLocale(lang)}/`}
>
  <div class="shell hero">
    <p class="mono-label kicker">{data.kicker}</p>
    <h1>
      {
        data.headline.map((line, index) => (
          <>
            {index > 0 && <br />}
            <DecodeText text={line} delay={data.headlineDelay + index * HEADLINE_STEP_MS} />
          </>
        ))
      }
    </h1>
    <p class="sub">
      {
        data.sub.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>
  </div>
  <Fragment set:html={`<!-- ${publicData.entry} -->`} />
  <section class="shell ctf">
    <Prose><Content /></Prose>
    <p class="mobile">{ctfPage.data.mobile}</p>
  </section>
</BaseLayout>
<style>
  .hero {
    padding-block: 3rem 1.5rem;
  }
  .kicker {
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-size: clamp(2.5rem, 12vw, 5.5rem);
  }
  .ctf {
    padding-block: 1.5rem 3rem;
  }
  .mobile {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  @media (max-width: 37.5rem) {
    .mobile {
      display: block;
    }
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 44ch;
    margin-top: 1.25rem;
  }
</style>
