---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Prose from '../../../components/Prose.astro';
import ProjectLinks from '../../../components/ProjectLinks.astro';
import ProjectLogo from '../../../components/ProjectLogo.astro';
import TechLogo from '../../../components/TechLogo.astro';
import { getProjects, type Project } from '../../../lib/entries';
import { formatRange } from '../../../data/cv';
import { slugOf } from '../../../lib/ids';
import { findCounterpart } from '../../../lib/translations';
import { useTranslations } from '../../../i18n/ui';
import { routePath } from '../../../i18n/routes';
import { otherLocale, type Locale } from '../../../i18n/locales';

interface Props {
  lang: Locale;
  project: Project;
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const slug = slugOf(project.id);

const other = otherLocale(lang);
const counterpart = findCounterpart(await getProjects(other), slug);
const altHref = counterpart
  ? `${routePath('projects', other)}${slug}/`
  : routePath('projects', other);
---
<BaseLayout
  lang={lang}
  current="projects"
  title={`${project.data.title} — Christian Dirnhofer`}
  description={project.data.summary}
  altHref={altHref}
  altAvailable={Boolean(counterpart)}
>
  <article class="shell">
    <div class="head">
      <ProjectLogo slug={slug} />
      <h1>{project.data.title}</h1>
    </div>
    <p class="summary">{project.data.summary}</p>
    <dl class="facts">
      <dt class="mono-label">{t('projects.role')}</dt>
      <dd>{project.data.role}</dd>
      <dt class="mono-label">{t('projects.period')}</dt>
      <dd>{formatRange(project.facts.begin, project.facts.end, lang)}</dd>
      <dt class="mono-label">{t('projects.stack')}</dt>
      <dd>
        <ul class="stack">
          {
            project.facts.stack.map((name) => (
              <li>
                <TechLogo name={name} />
                {name}
              </li>
            ))
          }
        </ul>
      </dd>
    </dl>
    <ProjectLinks lang={lang} links={project.facts.links} />
    <hr />
    <Prose><Content /></Prose>
  </article>
</BaseLayout>
<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 2rem;
  }
  h1 {
    font-size: clamp(1.9rem, 7vw, 3rem);
    margin: 0;
  }
  @media (max-width: 30rem) {
    .head {
      gap: 1rem;
      --logo-size: 4rem;
      --logo-padding: 0.5rem;
    }
  }
  .summary {
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1.5rem;
    margin-block: 1.5rem;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin-block: 1.5rem;
  }
</style>
