---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryRow from '../../../components/EntryRow.astro';
import { getProjects, getProjectsPage } from '../../../lib/entries';
import { slugOf } from '../../../lib/ids';
import { useTranslations } from '../../../i18n/ui';
import { routePath } from '../../../i18n/routes';
import { otherLocale, type Locale } from '../../../i18n/locales';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { data } = await getProjectsPage(lang);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const base = routePath('projects', lang);
---
<BaseLayout
  lang={lang}
  current="projects"
  title={data.title}
  description={data.description}
  altHref={routePath('projects', otherLocale(lang))}
>
  <div class="shell">
    <h1>{data.heading}</h1>
    {projects.length === 0 && <p class="mono-label">{data.empty}</p>}
    <ul class="rows">
      {
        projects.map((project, index) => (
          <EntryRow
            href={`${base}${slugOf(project.id)}/`}
            index={index}
            title={project.data.title}
            kind={t('projects.kind')}
          />
        ))
      }
    </ul>
  </div>
</BaseLayout>
<style>
  h1 {
    font-size: clamp(2rem, 8vw, 3.5rem);
    padding-block: 2rem 1.25rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
</style>
